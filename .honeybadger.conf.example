# Honeybadger Server Configuration
# Copy this file to .honeybadger.conf, ~/.honeybadger.conf, or /etc/honeybadger.conf
#
# Anything set in the environment overrides what this file says, and the client
# reports which settings it took from there. That is how a single run can be
# pointed somewhere else without editing this file:
#
#   SERVER_URL=http://localhost:7123/ ./RUNME.sh submit
#   DRY_RUN=true ./RUNME.sh submit
#
# To use a different file entirely:
#
#   ./RUNME.sh submit --config /path/to/other.conf
#   HONEYBADGER_CONFIG=/path/to/other.conf ./RUNME.sh submit

# Enable/disable server submission (default: false)
SERVER_ENABLED=false

# Server URL (default: http://localhost:7123/)
# Used for both JSON report submission (./RUNME.sh submit) and tar archive submission (./RUNME.sh submit-tar)
# Endpoints: SERVER_URL/ for JSON reports, SERVER_URL/submit-tar for tar archives
SERVER_URL=http://localhost:7123/

# Bearer token for authentication (required)
# Example: SERVER_TOKEN=hb_token_aabbccddeeff1122332c32055cbbf40c2
SERVER_TOKEN=

# Connection timeout in seconds (default: 30)
SERVER_TIMEOUT=30

# Number of retry attempts on network failures (default: 3)
SERVER_RETRY_COUNT=3

# Dry-run mode: log what would be submitted without actual HTTP requests (default: false)
DRY_RUN=false

# Use Docker-based Perl converter instead of the default Python converter (default: false)
# Both converters produce JSON only; the Docker image exists as an independent
# second implementation to cross-check the Python converter's output.
# When false, the Python script (lib/lynis_report_converter.py) is used (no Docker required)
USE_DOCKER_CONVERTER=false

# Lynis hardening score the reports compare against (default: 65)
# Informational only: the score never fails a device. Because the norm is
# configurable, every report that shows the score also states the threshold it
# applied, so a reader never has to guess which value was in force.
MIN_HARDENING_SCORE=65

# Note: Configuration files are checked in this order:
#   1. ./.honeybadger.conf (current directory)
#   2. ~/.honeybadger.conf (user home directory)
#   3. /etc/honeybadger.conf (system-wide)
# The first file found will be used.
