#!/usr/bin/env bash
#
# os-status.sh - Library for OS and Kernel status checking
#
# This library provides functions to check OS and kernel status,
# fetch release information, and validate system versions.
#
# Usage: source this file in your scripts
#

# ==============================================================================
# CONFIGURATION
# ==============================================================================

CACHE_DIR="${HONEYBADGER_CACHE_DIR:-.cache}"
CACHE_TTL=86400  # 24 hours

# ==============================================================================
# CACHE MANAGEMENT FUNCTIONS
# ==============================================================================

# Check if cache file is still valid
# Usage: is_cache_valid <cache_file> [ttl_seconds]
is_cache_valid() {
    local cache_file="$1"
    local ttl="${2:-$CACHE_TTL}"

    if [[ ! -f "$cache_file" ]]; then
        return 1
    fi

    local now=$(date +%s)
    local mtime=$(stat -c %Y "$cache_file" 2>/dev/null || stat -f %m "$cache_file" 2>/dev/null)
    local age=$((now - mtime))

    if [[ $age -lt $ttl ]]; then
        return 0
    else
        return 1
    fi
}

# Fetch data from URL
# Usage: fetch_url <url> <output_file>
fetch_url() {
    local url="$1"
    local output="$2"

    if command -v curl >/dev/null 2>&1; then
        curl -s -f "$url" > "$output" 2>/dev/null
        return $?
    else
        echo "ERROR: curl not found" >&2
        return 1
    fi
}

# ==============================================================================
# RELEASE DATA FETCHING FUNCTIONS
# ==============================================================================

# Fetch all OS and kernel release information
# Usage: fetch_os_releases [cache_dir]
fetch_os_releases() {
    local cache_dir="${1:-$CACHE_DIR}"
    mkdir -p "$cache_dir"

    echo "Fetching latest OS and kernel release information..."
    echo "Cache directory: $cache_dir"
    echo ""

    # Fetch NixOS releases
    if ! is_cache_valid "$cache_dir/nixos-releases.json" "$CACHE_TTL"; then
        echo "Fetching NixOS releases from endoflife.date..."
        if fetch_url "https://endoflife.date/api/nixos.json" "$cache_dir/nixos-releases.json"; then
            echo "  ✓ NixOS releases cached"
        else
            echo "  ✗ Failed to fetch NixOS releases"
        fi
    else
        echo "  → NixOS releases cache is still valid"
    fi

    # Fetch Ubuntu releases
    if ! is_cache_valid "$cache_dir/ubuntu-releases.json" "$CACHE_TTL"; then
        echo "Fetching Ubuntu releases from endoflife.date..."
        if fetch_url "https://endoflife.date/api/ubuntu.json" "$cache_dir/ubuntu-releases.json"; then
            echo "  ✓ Ubuntu releases cached"
        else
            echo "  ✗ Failed to fetch Ubuntu releases"
        fi
    else
        echo "  → Ubuntu releases cache is still valid"
    fi

    # Fetch Debian releases
    if ! is_cache_valid "$cache_dir/debian-releases.json" "$CACHE_TTL"; then
        echo "Fetching Debian releases from endoflife.date..."
        if fetch_url "https://endoflife.date/api/debian.json" "$cache_dir/debian-releases.json"; then
            echo "  ✓ Debian releases cached"
        else
            echo "  ✗ Failed to fetch Debian releases"
        fi
    else
        echo "  → Debian releases cache is still valid"
    fi

    # Fetch Linux kernel releases
    if ! is_cache_valid "$cache_dir/kernel-releases.json" "$CACHE_TTL"; then
        echo "Fetching Linux kernel releases from kernel.org..."
        if fetch_url "https://www.kernel.org/releases.json" "$cache_dir/kernel-releases.json"; then
            echo "  ✓ Kernel releases cached"
        else
            echo "  ✗ Failed to fetch kernel releases"
        fi
    else
        echo "  → Kernel releases cache is still valid"
    fi

    echo ""
    echo "Cache update complete!"
}

# ==============================================================================
# NIXOS QUERY FUNCTIONS
# ==============================================================================

# Get latest NixOS release version
# Usage: get_latest_nixos_release [cache_dir]
get_latest_nixos_release() {
    local cache_dir="${1:-$CACHE_DIR}"
    if [[ -f "$cache_dir/nixos-releases.json" ]] && command -v jq >/dev/null 2>&1; then
        jq -r '.[0].cycle' "$cache_dir/nixos-releases.json" 2>/dev/null
    fi
}

# Get NixOS EOL date for a specific version
# Usage: get_nixos_eol_date <version> [cache_dir]
get_nixos_eol_date() {
    local version="$1"
    local cache_dir="${2:-$CACHE_DIR}"
    if [[ -f "$cache_dir/nixos-releases.json" ]] && command -v jq >/dev/null 2>&1; then
        jq -r ".[] | select(.cycle == \"$version\") | .eol" "$cache_dir/nixos-releases.json" 2>/dev/null
    fi
}

# Check if NixOS version is current/supported
# Usage: check_nixos_is_current <version> [cache_dir]
# Returns: "current", "previous", "supported", "eol", or "unknown"
check_nixos_is_current() {
    local version="$1"
    local cache_dir="${2:-$CACHE_DIR}"

    if [[ -f "$cache_dir/nixos-releases.json" ]] && command -v jq >/dev/null 2>&1; then
        local latest=$(jq -r '.[0].cycle' "$cache_dir/nixos-releases.json" 2>/dev/null)
        if [[ "$version" == "$latest" ]]; then
            echo "current"
        else
            local second_latest=$(jq -r '.[1].cycle' "$cache_dir/nixos-releases.json" 2>/dev/null)
            if [[ "$version" == "$second_latest" ]]; then
                echo "previous"
            else
                # Check if EOL has passed
                local eol=$(jq -r ".[] | select(.cycle == \"$version\") | .eol" "$cache_dir/nixos-releases.json" 2>/dev/null)
                if [[ -n "$eol" ]]; then
                    local eol_ts=$(date -d "$eol" +%s 2>/dev/null || date -j -f "%Y-%m-%d" "$eol" +%s 2>/dev/null)
                    local now_ts=$(date +%s)
                    if [[ $now_ts -gt $eol_ts ]]; then
                        echo "eol"
                    else
                        echo "supported"
                    fi
                else
                    echo "unknown"
                fi
            fi
        fi
    fi
}

# ==============================================================================
# UBUNTU QUERY FUNCTIONS
# ==============================================================================

# Get latest Ubuntu LTS version
# Usage: get_latest_ubuntu_lts [cache_dir]
get_latest_ubuntu_lts() {
    local cache_dir="${1:-$CACHE_DIR}"
    if [[ -f "$cache_dir/ubuntu-releases.json" ]] && command -v jq >/dev/null 2>&1; then
        jq -r '.[] | select(.lts == true) | .cycle' "$cache_dir/ubuntu-releases.json" 2>/dev/null | head -1
    fi
}

# Check if Ubuntu version is current/supported
# Usage: check_ubuntu_is_current <version> [cache_dir]
# Returns: "current", "supported", "eol", or "unknown"
check_ubuntu_is_current() {
    local version="$1"
    local cache_dir="${2:-$CACHE_DIR}"

    if [[ -f "$cache_dir/ubuntu-releases.json" ]] && command -v jq >/dev/null 2>&1; then
        local is_eol=$(jq -r ".[] | select(.cycle == \"$version\") | .eol" "$cache_dir/ubuntu-releases.json" 2>/dev/null)
        if [[ -n "$is_eol" ]]; then
            local eol_ts=$(date -d "$is_eol" +%s 2>/dev/null || date -j -f "%Y-%m-%d" "$is_eol" +%s 2>/dev/null)
            local now_ts=$(date +%s)
            if [[ $now_ts -gt $eol_ts ]]; then
                echo "eol"
            else
                local latest=$(jq -r '.[] | select(.lts == true) | .cycle' "$cache_dir/ubuntu-releases.json" 2>/dev/null | head -1)
                if [[ "$version" == "$latest" ]]; then
                    echo "current"
                else
                    echo "supported"
                fi
            fi
        else
            echo "unknown"
        fi
    fi
}

# ==============================================================================
# KERNEL QUERY FUNCTIONS
# ==============================================================================

# Get kernel information
# Usage: get_kernel_info <kernel_version> [cache_dir]
get_kernel_info() {
    local kernel_version="$1"
    local cache_dir="${2:-$CACHE_DIR}"

    if [[ -f "$cache_dir/kernel-releases.json" ]] && command -v jq >/dev/null 2>&1; then
        jq -r ".releases[] | select(.version | startswith(\"${kernel_version}.\")) | {version: .version, moniker: .moniker, iseol: .iseol}" "$cache_dir/kernel-releases.json" 2>/dev/null | head -1
    fi
}

# ==============================================================================
# OS INFORMATION EXTRACTION
# ==============================================================================

# The one system information format this client reads.
#
# fastfetch.json is what the audit writes and the only member the collection
# server accepts. Reading neofetch.json, neofetch.txt or fastfetch.txt as well
# kept a retired shape alive in the code that most needs one shape, and the
# legacy path carried no kernel_latest - so a directory that took it produced a
# report with the kernel comparison silently missing.
#
# A directory without fastfetch.json is missing its system information. It is
# not a directory in an older format to be read differently.
#
# Usage: require_fastfetch_json <output_dir>
# Returns: 0 when present, 1 otherwise (with an explanation on stderr)
require_fastfetch_json() {
    local output_dir="$1"

    [[ -f "$output_dir/fastfetch.json" ]] && return 0

    echo "ERROR: $output_dir/fastfetch.json is missing" >&2
    echo "  System information is read from fastfetch.json and nothing else." >&2
    echo "  It is written by: sudo ./RUNME.sh audit" >&2

    local legacy found=""
    for legacy in neofetch.json neofetch.txt fastfetch.txt; do
        [[ -f "$output_dir/$legacy" ]] && found+=" $legacy"
    done
    if [[ -n "$found" ]]; then
        echo "  This directory carries a retired format ($found ) from before the" >&2
        echo "  fastfetch migration. Those archives stay readable, but re-analysis" >&2
        echo "  needs an audit from a current client." >&2
    fi

    return 1
}

# Extract OS information from Honeybadger output directory
# Usage: extract_os_info <output_dir>
# Sets global variables: OS_NAME, OS_VERSION, OS_CODENAME, OS_FULLNAME, KERNEL_VERSION
extract_os_info() {
    local output_dir="$1"

    # Initialize variables
    OS_NAME=""
    OS_VERSION=""
    OS_CODENAME=""
    OS_FULLNAME=""
    KERNEL_VERSION=""

    # Try to get info from lynis-report.json (most reliable)
    if [[ -f "$output_dir/lynis-report.json" ]]; then
        if command -v jq >/dev/null 2>&1; then
            OS_NAME=$(jq -r '.os_name // empty' "$output_dir/lynis-report.json" 2>/dev/null)
            OS_VERSION=$(jq -r '.os_version // empty' "$output_dir/lynis-report.json" 2>/dev/null)
            OS_FULLNAME=$(jq -r '.os_fullname // empty' "$output_dir/lynis-report.json" 2>/dev/null)
            KERNEL_RAW=$(jq -r '.linux_kernel_version // empty' "$output_dir/lynis-report.json" 2>/dev/null)
        fi
    fi

    local fetch_file="$output_dir/fastfetch.json"

    if [[ -f "$fetch_file" ]]; then
        # Get OS info if not already set
        if [[ -z "$OS_NAME" ]]; then
            OS_FULLNAME=$(jq -r '.os // empty' "$fetch_file" 2>/dev/null)

            if [[ -n "$OS_FULLNAME" ]]; then
                # Handle different formats
                if [[ "$OS_FULLNAME" =~ "Kali" ]]; then
                    OS_NAME="Kali"
                    OS_VERSION=$(echo "$OS_FULLNAME" | grep -oP 'Rolling|\d+\.\d+' | head -1)
                else
                    OS_NAME=$(echo "$OS_FULLNAME" | awk '{print $1}')
                    OS_VERSION=$(echo "$OS_FULLNAME" | awk '{print $2}' | cut -d. -f1-2)
                fi
                OS_CODENAME=$(echo "$OS_FULLNAME" | grep -oP '\(\K[^)]+' || echo "")
            fi
        fi

        # Always try to get kernel from fetch file
        if [[ -z "$KERNEL_VERSION" ]]; then
            KERNEL_RAW=$(jq -r '.kernel // empty' "$fetch_file" 2>/dev/null)
            [[ -n "$KERNEL_RAW" ]] && KERNEL_VERSION=$(echo "$KERNEL_RAW" | grep -oP '\d+\.\d+\.\d+' | head -1)
        fi
    fi

    # Fallback to lsb_release.txt
    if [[ -z "$OS_NAME" && -f "$output_dir/lsb_release.txt" ]]; then
        OS_NAME=$(grep "^Distributor ID:" "$output_dir/lsb_release.txt" | cut -d: -f2- | xargs)
        OS_VERSION=$(grep "^Release:" "$output_dir/lsb_release.txt" | cut -d: -f2- | xargs)
        OS_CODENAME=$(grep "^Codename:" "$output_dir/lsb_release.txt" | cut -d: -f2- | xargs)
    fi

    # Export variables for use in calling script
    export OS_NAME OS_VERSION OS_CODENAME OS_FULLNAME KERNEL_VERSION
}

# ==============================================================================
# OS STATUS CHECKING
# ==============================================================================

# Write os-kernel-status.txt for an audit output directory, and print it.
#
# The exit status says whether the report was produced - a missing directory, or
# one with no system information. It is never a severity. An OS approaching end
# of life is a finding, and a finding is not a failed run: a caller on a
# schedule has to be able to tell a broken client from a machine whose kernel is
# a patch behind.
#
# The severity lives in the report, under SECTION 1 and the summary, and in the
# compliance report that reads it. `lib/check-os-status.sh` is a separate entry
# point that does exit a severity, deliberately - see its header.
#
# Usage: generate_os_status_report <output_dir> [cache_dir]
# Returns: 0 when the report was written, non-zero when it could not be
generate_os_status_report() {
    local output_dir="$1"
    local cache_dir="${2:-$CACHE_DIR}"

    if [[ ! -d "$output_dir" ]]; then
        echo "ERROR: Directory $output_dir does not exist"
        return 1
    fi

    # Before anything is fetched or written: no system information, no analysis.
    require_fastfetch_json "$output_dir" || return 1

    # Fetch latest release info if needed
    if [[ ! -d "$cache_dir" ]] || [[ ! -f "$cache_dir/nixos-releases.json" ]]; then
        fetch_os_releases "$cache_dir" >/dev/null 2>&1
    fi

    # Extract OS information
    extract_os_info "$output_dir"

    if [[ -z "$OS_NAME" ]]; then
        echo "ERROR: Unable to extract OS information from output files"
        return 1
    fi

    # Generate report
    local report_file="$output_dir/os-kernel-status.txt"

    echo "=====================================" > "$report_file"
    echo "  OS & KERNEL STATUS ANALYSIS" >> "$report_file"
    echo "=====================================" >> "$report_file"
    echo "Analysis Date: $(date)" >> "$report_file"
    echo "Source: $output_dir" >> "$report_file"
    echo "" >> "$report_file"

    echo "=====================================" >> "$report_file"
    echo "SECTION 1: OPERATING SYSTEM STATUS" >> "$report_file"
    echo "=====================================" >> "$report_file"
    echo "" >> "$report_file"

    echo "Detected OS: $OS_NAME" >> "$report_file"
    echo "Version: $OS_VERSION" >> "$report_file"
    [[ -n "$OS_CODENAME" ]] && echo "Codename: $OS_CODENAME" >> "$report_file"
    [[ -n "$OS_FULLNAME" ]] && echo "Full Name: $OS_FULLNAME" >> "$report_file"
    echo "" >> "$report_file"

    # Variable to track overall status
    local os_status_result="unknown"

    # Analyze based on OS type
    case "$OS_NAME" in
        NixOS)
            os_status_result=$(analyze_nixos_status "$report_file" "$cache_dir")
            ;;
        Ubuntu)
            os_status_result=$(analyze_ubuntu_status "$report_file" "$cache_dir")
            ;;
        Debian)
            os_status_result=$(analyze_debian_status "$report_file" "$cache_dir")
            ;;
        Arch|"Arch Linux")
            os_status_result=$(analyze_arch_status "$report_file")
            ;;
        Kali|"Kali Linux")
            os_status_result=$(analyze_kali_status "$report_file")
            ;;
        *)
            echo "Distribution: $OS_NAME (Unknown/Unsupported)" >> "$report_file"
            echo "Status: UNABLE TO DETERMINE" >> "$report_file"
            os_status_result="unknown"
            ;;
    esac

    # Analyze kernel
    local kernel_status_result="unknown"
    if [[ -n "$KERNEL_VERSION" ]]; then
        kernel_status_result=$(analyze_kernel_status "$report_file" "$cache_dir")
    fi

    # Generate summary with status and recommendations
    generate_status_summary "$report_file" "$os_status_result" "$kernel_status_result" "$cache_dir"

    # Print report
    cat "$report_file"
}

# Analyze NixOS status (helper function)
# Returns: "pass", "warning", "fail", or "unknown"
analyze_nixos_status() {
    local report_file="$1"
    local cache_dir="$2"

    echo "Distribution: NixOS (Rolling/Stable)" >> "$report_file"
    echo "" >> "$report_file"

    local nixos_status=$(check_nixos_is_current "$OS_VERSION" "$cache_dir")
    local nixos_eol=$(get_nixos_eol_date "$OS_VERSION" "$cache_dir")
    local latest_nixos=$(get_latest_nixos_release "$cache_dir")
    local result="unknown"

    echo "1. IS CURRENT OS VERSION AN ACTIVE UPDATE STREAM?" >> "$report_file"
    echo "---------------------------------------------------" >> "$report_file"

    case "$nixos_status" in
        current)
            echo "Status: YES - CURRENT STABLE RELEASE" >> "$report_file"
            echo "Update Stream: ACTIVE" >> "$report_file"
            result="pass"
            ;;
        previous|supported)
            if [[ "$nixos_status" == "previous" ]]; then
                echo "Status: YES - PREVIOUS STABLE (still supported)" >> "$report_file"
            else
                echo "Status: YES - OLDER VERSION (still receiving updates)" >> "$report_file"
            fi
            echo "Update Stream: ACTIVE (but upgrade recommended)" >> "$report_file"
            [[ -n "$nixos_eol" ]] && echo "Support until: $nixos_eol" >> "$report_file"
            [[ -n "$latest_nixos" ]] && echo "Recommendation: Upgrade to $latest_nixos" >> "$report_file"
            result="warning"
            ;;
        eol)
            echo "Status: NO - END OF LIFE" >> "$report_file"
            echo "Update Stream: INACTIVE (no longer receives updates)" >> "$report_file"
            [[ -n "$nixos_eol" ]] && echo "EOL Date: $nixos_eol" >> "$report_file"
            [[ -n "$latest_nixos" ]] && echo "CRITICAL: Upgrade to NixOS $latest_nixos immediately" >> "$report_file"
            result="fail"
            ;;
        *)
            echo "Status: UNKNOWN VERSION" >> "$report_file"
            echo "Update Stream: UNABLE TO DETERMINE" >> "$report_file"
            result="unknown"
            ;;
    esac

    echo "" >> "$report_file"
    echo "$result"
}

# Analyze Ubuntu status (helper function)
# Returns: "pass", "warning", "fail", or "unknown"
analyze_ubuntu_status() {
    local report_file="$1"
    local cache_dir="$2"

    echo "Distribution: Ubuntu Linux" >> "$report_file"
    echo "" >> "$report_file"
    echo "1. IS CURRENT OS VERSION AN ACTIVE UPDATE STREAM?" >> "$report_file"
    echo "---------------------------------------------------" >> "$report_file"

    local ubuntu_status=$(check_ubuntu_is_current "$OS_VERSION" "$cache_dir")
    local latest_ubuntu=$(get_latest_ubuntu_lts "$cache_dir")
    local result="unknown"

    case "$ubuntu_status" in
        current)
            echo "Status: YES - CURRENT LTS" >> "$report_file"
            echo "Update Stream: ACTIVE" >> "$report_file"
            result="pass"
            ;;
        supported)
            echo "Status: YES - OLDER LTS (still receiving updates)" >> "$report_file"
            echo "Update Stream: ACTIVE (but upgrade recommended)" >> "$report_file"
            [[ -n "$latest_ubuntu" ]] && echo "Recommendation: Upgrade to Ubuntu $latest_ubuntu LTS" >> "$report_file"
            result="warning"
            ;;
        eol)
            echo "Status: NO - END OF LIFE" >> "$report_file"
            echo "Update Stream: INACTIVE (no longer receives updates)" >> "$report_file"
            [[ -n "$latest_ubuntu" ]] && echo "CRITICAL: Upgrade to Ubuntu $latest_ubuntu LTS immediately" >> "$report_file"
            result="fail"
            ;;
        *)
            echo "Status: UNKNOWN VERSION" >> "$report_file"
            result="unknown"
            ;;
    esac

    echo "" >> "$report_file"
    echo "$result"
}

# Analyze Debian status (helper function)
# Returns: "pass", "warning", "fail", or "unknown"
analyze_debian_status() {
    local report_file="$1"
    local cache_dir="$2"

    echo "Distribution: Debian GNU/Linux" >> "$report_file"
    echo "Version: $OS_VERSION" >> "$report_file"
    echo "" >> "$report_file"
    echo "pass"
}

# Analyze Arch status (helper function)
# Returns: "pass", "warning", "fail", or "unknown"
analyze_arch_status() {
    local report_file="$1"

    echo "Distribution: Arch Linux (Rolling Release)" >> "$report_file"
    echo "Status: YES - ALWAYS CURRENT (if regularly updated)" >> "$report_file"
    echo "Update Stream: ROLLING RELEASE (no versions)" >> "$report_file"
    echo "" >> "$report_file"
    echo "pass"
}

# Analyze Kali status (helper function)
# Returns: "pass", "warning", "fail", or "unknown"
analyze_kali_status() {
    local report_file="$1"

    echo "Distribution: Kali Linux (Debian-based, Rolling)" >> "$report_file"
    echo "Status: YES - ROLLING RELEASE" >> "$report_file"
    echo "Update Stream: ACTIVE" >> "$report_file"
    echo "" >> "$report_file"
    echo "pass"
}

# Analyze kernel status (helper function)
analyze_kernel_status() {
    local report_file="$1"
    local cache_dir="$2"
    local result="unknown"

    # Derive output directory from report file location (report is always $output_dir/os-kernel-status.txt)
    local output_dir
    output_dir=$(dirname "$report_file")

    echo "=====================================" >> "$report_file"
    echo "SECTION 2: KERNEL VERSION STATUS" >> "$report_file"
    echo "=====================================" >> "$report_file"
    echo "" >> "$report_file"
    echo "Detected Kernel: $KERNEL_VERSION" >> "$report_file"
    echo "" >> "$report_file"

    if [[ -z "$KERNEL_VERSION" ]]; then
        echo "Status: UNKNOWN - kernel version not detected" >> "$report_file"
        echo "" >> "$report_file"
        echo "$result"
        return
    fi

    # Extract major.minor series — handles "6.18.37" and "6.8.0-60-generic"
    local kernel_series
    kernel_series=$(echo "$KERNEL_VERSION" | grep -oE '^[0-9]+\.[0-9]+')

    if [[ -z "$kernel_series" ]]; then
        echo "Status: UNKNOWN - unable to parse kernel series" >> "$report_file"
        echo "" >> "$report_file"
        echo "$result"
        return
    fi

    echo "Kernel Series: ${kernel_series}.x" >> "$report_file"

    # Primary data source: fastfetch.json kernel_latest field (populated during collection)
    local kernel_latest_raw="" latest_version="" latest_date="" series_is_eol="false"
    local fastfetch_file="$output_dir/fastfetch.json"

    if [[ -f "$fastfetch_file" ]] && command -v jq >/dev/null 2>&1; then
        kernel_latest_raw=$(jq -r '.kernel_latest // ""' "$fastfetch_file" 2>/dev/null)
    fi

    if [[ -n "$kernel_latest_raw" && "$kernel_latest_raw" != "null" && "$kernel_latest_raw" != "" ]]; then
        # Format: "6.18.38 (2026-07-04)"
        latest_version=$(echo "$kernel_latest_raw" | grep -oE '^[0-9]+\.[0-9]+\.[0-9]+')
        latest_date=$(echo "$kernel_latest_raw" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}')
    else
        # Fallback: kernel-releases.json cache
        if [[ -f "$cache_dir/kernel-releases.json" ]] && command -v jq >/dev/null 2>&1; then
            latest_version=$(jq -r ".releases[] | select(.version | startswith(\"${kernel_series}.\")) | .version" \
                "$cache_dir/kernel-releases.json" 2>/dev/null | head -1)
            latest_date=$(jq -r ".releases[] | select(.version | startswith(\"${kernel_series}.\")) | .released.isodate" \
                "$cache_dir/kernel-releases.json" 2>/dev/null | head -1)
            series_is_eol=$(jq -r ".releases[] | select(.version | startswith(\"${kernel_series}.\")) | .iseol" \
                "$cache_dir/kernel-releases.json" 2>/dev/null | head -1)
            series_is_eol="${series_is_eol:-false}"
        fi

        # EOL check takes priority — iseol:true can coexist with a version entry
        if [[ "$series_is_eol" == "true" ]]; then
            echo "Type: EOL (upstream End-of-Life)" >> "$report_file"
            echo "" >> "$report_file"
            echo "1. EOL STATUS" >> "$report_file"
            echo "-------------" >> "$report_file"
            echo "Status: ✗ END OF LIFE" >> "$report_file"
            echo "  The ${kernel_series}.x series is no longer maintained upstream." >> "$report_file"
            echo "  No further security patches will be released." >> "$report_file"
            echo "" >> "$report_file"
            echo "fail"
            return
        fi

        if [[ -z "$latest_version" || "$latest_version" == "null" ]]; then
            echo "Status: UNKNOWN - kernel series ${kernel_series}.x not found in available data" >> "$report_file"
            echo "" >> "$report_file"
            echo "$result"
            return
        fi
    fi

    # Determine kernel type from cache if available
    local moniker=""
    if [[ -f "$cache_dir/kernel-releases.json" ]] && command -v jq >/dev/null 2>&1; then
        moniker=$(jq -r ".releases[] | select(.version | startswith(\"${kernel_series}.\")) | .moniker" \
            "$cache_dir/kernel-releases.json" 2>/dev/null | head -1)
    fi

    local type_label
    case "$moniker" in
        mainline)   type_label="Mainline (short-lived, ~3 months support)" ;;
        stable)     type_label="Stable" ;;
        longterm)   type_label="Long-Term Support (LTS)" ;;
        linux-next) type_label="linux-next (development only)" ;;
        *)          type_label="${moniker:-Unknown}" ;;
    esac

    echo "Type: $type_label" >> "$report_file"
    [[ -n "$latest_version" ]] && echo "Latest in series: $latest_version${latest_date:+ (released: $latest_date)}" >> "$report_file"
    echo "" >> "$report_file"

    # 1. EOL status
    echo "1. EOL STATUS" >> "$report_file"
    echo "-------------" >> "$report_file"
    echo "Status: ✓ SUPPORTED - ${kernel_series}.x receives security patches" >> "$report_file"
    echo "" >> "$report_file"
    result="pass"

    # 2. Patch currency — distro-aware
    local running_upstream
    running_upstream=$(echo "$KERNEL_VERSION" | grep -oE '^[0-9]+\.[0-9]+\.[0-9]+')

    echo "2. PATCH CURRENCY" >> "$report_file"
    echo "-----------------" >> "$report_file"

    if [[ -z "$running_upstream" || -z "$latest_version" ]]; then
        echo "Status: UNABLE TO DETERMINE" >> "$report_file"
    elif [[ "$running_upstream" == "$latest_version" ]]; then
        echo "Status: ✓ UP TO DATE - running latest patch ($latest_version)" >> "$report_file"
    else
        case "$OS_NAME" in
            NixOS|Arch|"Arch Linux")
                echo "Status: ⚠ PATCH AVAILABLE" >> "$report_file"
                echo "  Running: $running_upstream" >> "$report_file"
                echo "  Latest:  $latest_version${latest_date:+ (released: $latest_date)}" >> "$report_file"
                result="warning"
                ;;
            Ubuntu)
                echo "Status: ℹ INFO - upstream patch available (Ubuntu maintains own kernel numbering)" >> "$report_file"
                echo "  Running: $running_upstream" >> "$report_file"
                echo "  Upstream latest: $latest_version${latest_date:+ (released: $latest_date)}" >> "$report_file"
                echo "  Ubuntu may continue to support this kernel; verify via Ubuntu security advisories." >> "$report_file"
                ;;
            Debian)
                echo "Status: ℹ INFO - upstream patch available (Debian maintains own kernel patch numbering)" >> "$report_file"
                echo "  Running: $running_upstream" >> "$report_file"
                echo "  Upstream latest: $latest_version${latest_date:+ (released: $latest_date)}" >> "$report_file"
                ;;
            *)
                echo "Status: ⚠ PATCH AVAILABLE" >> "$report_file"
                echo "  Running: $running_upstream" >> "$report_file"
                echo "  Latest:  $latest_version${latest_date:+ (released: $latest_date)}" >> "$report_file"
                result="warning"
                ;;
        esac
    fi
    echo "" >> "$report_file"

    echo "$result"
}

# Generate status summary (helper function)
# Usage: generate_status_summary <report_file> <os_status> <kernel_status> <cache_dir>
generate_status_summary() {
    local report_file="$1"
    local os_status="$2"
    local kernel_status="$3"
    local cache_dir="$4"

    # Worst-of logic: fail > warning > pass; unknown does not degrade os_status
    local combined_status="$os_status"
    if [[ "$os_status" == "fail" || "$kernel_status" == "fail" ]]; then
        combined_status="fail"
    elif [[ "$os_status" == "warning" || "$kernel_status" == "warning" ]]; then
        combined_status="warning"
    elif [[ "$os_status" == "pass" && "$kernel_status" == "pass" ]]; then
        combined_status="pass"
    fi

    echo "" >> "$report_file"
    echo "=====================================" >> "$report_file"
    echo "OVERALL SYSTEM STATUS" >> "$report_file"
    echo "=====================================" >> "$report_file"
    echo "" >> "$report_file"

    case "$combined_status" in
        pass)
            echo "Result: ✓ PASS" >> "$report_file"
            echo "" >> "$report_file"
            echo "Your system is running a supported operating system version" >> "$report_file"
            echo "with an active update stream. No immediate action required." >> "$report_file"
            echo "" >> "$report_file"
            echo "Recommendations:" >> "$report_file"
            echo "  - Continue applying regular system updates" >> "$report_file"
            echo "  - Monitor for new releases and security updates" >> "$report_file"
            echo "  - Review this report periodically (at least quarterly)" >> "$report_file"
            ;;
        warning)
            echo "Result: ⚠ WARNING" >> "$report_file"
            echo "" >> "$report_file"
            echo "Your system is NOT running the latest version but STILL RECEIVES UPDATES." >> "$report_file"
            echo "An upgrade is recommended but not critical." >> "$report_file"
            echo "" >> "$report_file"
            echo "Recommendations:" >> "$report_file"
            echo "  - Plan an upgrade to the latest stable release" >> "$report_file"
            echo "  - Continue applying security updates in the meantime" >> "$report_file"
            echo "  - Review the upgrade path and test in a staging environment" >> "$report_file"

            # OS-specific upgrade recommendation — only when OS itself is outdated
            if [[ "$os_status" == "warning" ]]; then
                local latest_release=""
                case "$OS_NAME" in
                    NixOS)
                        latest_release=$(get_latest_nixos_release "$cache_dir")
                        [[ -n "$latest_release" ]] && echo "  - Target OS version: NixOS $latest_release" >> "$report_file"
                        ;;
                    Ubuntu)
                        latest_release=$(get_latest_ubuntu_lts "$cache_dir")
                        [[ -n "$latest_release" ]] && echo "  - Target OS version: Ubuntu $latest_release LTS" >> "$report_file"
                        ;;
                esac
            fi

            # Kernel-specific recommendation when kernel triggered the warning
            if [[ "$kernel_status" == "warning" ]]; then
                echo "  - Apply kernel updates via regular system updates (e.g. nixos-rebuild switch --upgrade, apt upgrade)" >> "$report_file"
            fi
            ;;
        fail)
            echo "Result: ✗ FAIL" >> "$report_file"
            echo "" >> "$report_file"
            echo "CRITICAL: Your system NO LONGER RECEIVES UPDATES (End-of-Life)." >> "$report_file"
            echo "This version has reached EOL and no longer receives security updates." >> "$report_file"
            echo "This poses a significant security risk." >> "$report_file"
            echo "" >> "$report_file"
            echo "URGENT Actions Required:" >> "$report_file"
            echo "  1. DO NOT connect this system to untrusted networks" >> "$report_file"
            echo "  2. Plan an immediate upgrade to a supported version" >> "$report_file"
            echo "  3. If upgrade is not immediately possible:" >> "$report_file"
            echo "     - Isolate the system from the internet" >> "$report_file"
            echo "     - Restrict network access to essential services only" >> "$report_file"
            echo "     - Increase monitoring and auditing" >> "$report_file"
            echo "  4. Document the security risk and create an upgrade timeline" >> "$report_file"

            # OS-specific upgrade recommendation
            local latest_release=""
            case "$OS_NAME" in
                NixOS)
                    latest_release=$(get_latest_nixos_release "$cache_dir")
                    [[ -n "$latest_release" ]] && echo "  5. Upgrade OS to: NixOS $latest_release" >> "$report_file"
                    ;;
                Ubuntu)
                    latest_release=$(get_latest_ubuntu_lts "$cache_dir")
                    [[ -n "$latest_release" ]] && echo "  5. Upgrade OS to: Ubuntu $latest_release LTS" >> "$report_file"
                    ;;
            esac

            # Kernel-specific recommendation when kernel triggered the fail
            if [[ "$kernel_status" == "fail" ]]; then
                echo "  - KERNEL EOL: upgrade to a supported kernel series immediately" >> "$report_file"
                echo "    Check https://www.kernel.org for supported series" >> "$report_file"
            fi

            echo "" >> "$report_file"
            echo "ISO27001 Compliance Note:" >> "$report_file"
            echo "Running EOL software may violate security policies and compliance" >> "$report_file"
            echo "requirements. Document this finding and escalate appropriately." >> "$report_file"
            ;;
        *)
            echo "Result: ? UNKNOWN" >> "$report_file"
            echo "" >> "$report_file"
            echo "Unable to determine system status. This may be due to:" >> "$report_file"
            echo "  - Unsupported or unrecognized operating system" >> "$report_file"
            echo "  - Missing or incomplete system information" >> "$report_file"
            echo "  - Unable to fetch release data from external sources" >> "$report_file"
            echo "" >> "$report_file"
            echo "Recommendations:" >> "$report_file"
            echo "  - Verify system information is correctly reported" >> "$report_file"
            echo "  - Check internet connectivity for release data updates" >> "$report_file"
            echo "  - Manually verify OS version support status" >> "$report_file"
            echo "  - Consult your OS vendor's support lifecycle documentation" >> "$report_file"
            ;;
    esac

    echo "" >> "$report_file"
    echo "=====================================" >> "$report_file"
    echo "END OF REPORT" >> "$report_file"
    echo "=====================================" >> "$report_file"
}

# ==============================================================================
# HOSTNAME RESOLUTION
# ==============================================================================
#
# The hostname names the output directory and the tar archive, so the fleet can
# tell one submission from another. It is resolved from sources that exist
# everywhere rather than from hostname(1), which is not part of Arch's base
# install - a host without inetutils used to produce output--<user>-<date> and
# say nothing about it.
#
# Order, each consulted only when the previous produced nothing usable:
#
#   1. uname -n         coreutils; asks the kernel, so it cannot be stale
#   2. $HOSTNAME        set by bash itself; needs no executable at all
#   3. /etc/hostname    configuration rather than state, hence last

# Whether a candidate can serve as a path component and part of a filename.
# This is not a DNS check: "localhost" is a poor name for a fleet asset but it
# is what the machine is called, and substituting something else invents data.
# Usage: hb_usable_hostname <value>
# Returns: 0 when usable, 1 otherwise
hb_usable_hostname() {
    local value="$1"

    [[ -z "$value" ]] && return 1
    # uname -n on a misconfigured host has been seen to return a bare newline
    [[ "$value" =~ [[:space:]] ]] && return 1
    [[ "$value" =~ [[:cntrl:]] ]] && return 1
    # A slash would silently move where the output directory is created
    [[ "$value" == */* ]] && return 1

    return 0
}

# Cut a fully qualified name down to its first label, as `hostname -s` did.
# A name without a dot comes back unchanged.
_hb_shorten_hostname() {
    printf '%s' "${1%%.*}"
}

# Print the machine's short hostname on stdout.
# Returns 1 and prints nothing when no source yields a usable name; the caller
# decides what that means. Declaration and assignment are kept apart on purpose:
# `local x=$(cmd)` returns the builtin's status, not the command's, which is how
# the missing hostname(1) stayed invisible in the first place.
hb_resolve_short_hostname() {
    local hostname_file="${HB_HOSTNAME_FILE:-/etc/hostname}"
    local candidate=""

    if command -v uname >/dev/null 2>&1; then
        if candidate=$(uname -n 2>/dev/null); then
            candidate=$(_hb_shorten_hostname "$candidate")
            if hb_usable_hostname "$candidate"; then
                printf '%s' "$candidate"
                return 0
            fi
        fi
    fi

    candidate=$(_hb_shorten_hostname "${HOSTNAME:-}")
    if hb_usable_hostname "$candidate"; then
        printf '%s' "$candidate"
        return 0
    fi

    if [[ -r "$hostname_file" ]]; then
        # The `read` builtin takes the first line without spawning anything, so
        # this source works even where coreutils is unavailable. Its status is
        # ignored deliberately: a file with no trailing newline makes it return
        # 1 while still having read the name. The usability check decides.
        candidate=""
        IFS= read -r candidate < "$hostname_file" || true
        candidate=$(_hb_shorten_hostname "$candidate")
        if hb_usable_hostname "$candidate"; then
            printf '%s' "$candidate"
            return 0
        fi
    fi

    return 1
}

# ==============================================================================
# HARDWARE SERIAL COLLECTION
# ==============================================================================
#
# The hardware serial is the key the collection server matches a submission to
# an asset on, so the audit reads it from the kernel first and only falls back
# to external tools. Every platform runs the same usability check before a
# value is written, because a value the server rejects helps nobody and a
# fragment of unrelated output is worse than nothing: it looks like data.
#
# Results are returned through three globals, set by collect_hardware_serial():
#
#   HB_SERIAL_VALUE    the serial, empty unless HB_SERIAL_STATUS is "ok"
#   HB_SERIAL_SOURCE   which source produced it, or which failed last
#   HB_SERIAL_STATUS   ok | none-present | could-not-read

# Values firmware reports in place of a real serial. Kept identical to the list
# the collection server applies when matching, compared case-insensitively.
HB_SERIAL_PLACEHOLDERS=(
    "not available"
    "not available (vm or unknown hardware)"
    "to be filled by o.e.m."
    "to be filled"
    "default string"
    "not specified"
    "system serial number"
    "none"
    "unknown"
)

# The two tokens written when no usable serial could be determined.
HB_SERIAL_NOT_READ="could-not-read"
HB_SERIAL_NOT_PRESENT="none-present"

# Decide whether a value is a usable hardware serial.
# A usable serial is one token: non-empty, free of whitespace and control
# characters, not a known placeholder and not all zeroes.
# Usage: is_usable_serial <value>
# Returns: 0 when usable, 1 otherwise
is_usable_serial() {
    local value="$1"

    [[ -z "$value" ]] && return 1
    # A serial is a single token. "Mac OS X<TAB>" fails here, as it should.
    [[ "$value" =~ [[:space:]] ]] && return 1
    [[ "$value" =~ [[:cntrl:]] ]] && return 1
    # All zeroes, at any length, is a firmware default rather than a measurement
    [[ "$value" =~ ^0+$ ]] && return 1
    # So are the two tokens this tool itself writes when there is no serial
    [[ "$value" == "$HB_SERIAL_NOT_READ" || "$value" == "$HB_SERIAL_NOT_PRESENT" ]] && return 1

    local lower placeholder
    lower=$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')
    for placeholder in "${HB_SERIAL_PLACEHOLDERS[@]}"; do
        [[ "$lower" == "$placeholder" ]] && return 1
    done

    return 0
}

# Strip line endings from a raw source value. Any remaining whitespace is left
# in place so is_usable_serial() can reject it.
# Usage: _hb_serial_clean <value>
_hb_serial_clean() {
    printf '%s' "$1" | tr -d '\r\n'
}

# Extract IOPlatformSerialNumber from `ioreg -d2 -c IOPlatformExpertDevice`.
# Reads the ioreg output on stdin so it can be tested against captured output.
hb_parse_ioreg_serial() {
    awk -F'"' '/IOPlatformSerialNumber/ { print $(NF-1); exit }'
}

# Extract the serial from `system_profiler SPHardwareDataType`.
# Reads the system_profiler output on stdin. Restricting the caller to
# SPHardwareDataType keeps this to the one "Serial Number" line that matters.
hb_parse_system_profiler_serial() {
    awk '/Serial Number/ { sub(/^[^:]*:[[:space:]]*/, ""); print; exit }'
}

# Determine whether this machine runs NixOS, for the nix fallback only.
# is_nixos() answers the same question about an audit output directory; this
# one asks about the running system.
hb_running_on_nixos() {
    local os_release="${HB_OS_RELEASE_FILE:-/etc/os-release}"

    [[ -f "$os_release" ]] && grep -q '^ID=nixos' "$os_release" 2>/dev/null && return 0
    command -v nixos-version >/dev/null 2>&1 && return 0
    return 1
}

# Linux serial chain. Each source is tried only when the previous produced
# nothing usable, so a machine with working sysfs never pays for the rest.
#
#   1. /sys/class/dmi/id/product_serial   root, no tool, no network
#   2. /sys/class/dmi/id/board_serial     some vendors fill only this one
#   3. dmidecode -s system-serial-number  when the tool happens to be present
#   4. nix run nixpkgs#dmidecode          NixOS last resort, needs the network
#
# Sets HB_SERIAL_VALUE / HB_SERIAL_SOURCE / HB_SERIAL_STATUS.
hb_collect_serial_linux() {
    local product_serial="${HB_SYSFS_PRODUCT_SERIAL:-/sys/class/dmi/id/product_serial}"
    local board_serial="${HB_SYSFS_BOARD_SERIAL:-/sys/class/dmi/id/board_serial}"
    # Whether any source answered at all. A source that answered with an empty
    # or placeholder value means the hardware has no serial; a source that
    # could not be consulted at all means we failed to read one.
    local responded=0
    local raw=""

    if [[ -r "$product_serial" ]]; then
        responded=1
        raw=$(_hb_serial_clean "$(cat "$product_serial" 2>/dev/null)")
        if is_usable_serial "$raw"; then
            HB_SERIAL_VALUE="$raw"
            HB_SERIAL_SOURCE="sysfs:product_serial"
            HB_SERIAL_STATUS="ok"
            return 0
        fi
    fi

    if [[ -r "$board_serial" ]]; then
        responded=1
        raw=$(_hb_serial_clean "$(cat "$board_serial" 2>/dev/null)")
        if is_usable_serial "$raw"; then
            HB_SERIAL_VALUE="$raw"
            HB_SERIAL_SOURCE="sysfs:board_serial"
            HB_SERIAL_STATUS="ok"
            return 0
        fi
    fi

    if command -v dmidecode >/dev/null 2>&1; then
        if raw=$(dmidecode -s system-serial-number 2>/dev/null); then
            responded=1
            raw=$(_hb_serial_clean "$raw")
            if is_usable_serial "$raw"; then
                HB_SERIAL_VALUE="$raw"
                HB_SERIAL_SOURCE="dmidecode"
                HB_SERIAL_STATUS="ok"
                return 0
            fi
        fi
    fi

    # Last resort, and only on NixOS: fetching dmidecode needs flakes enabled
    # and the network on first use. With sysfs first it should never be reached.
    if hb_running_on_nixos && command -v nix >/dev/null 2>&1; then
        if raw=$(nix run nixpkgs#dmidecode \
                     --extra-experimental-features "nix-command flakes" \
                     -- -s system-serial-number 2>/dev/null); then
            responded=1
            raw=$(_hb_serial_clean "$raw")
            if is_usable_serial "$raw"; then
                HB_SERIAL_VALUE="$raw"
                HB_SERIAL_SOURCE="nix:dmidecode"
                HB_SERIAL_STATUS="ok"
                return 0
            fi
        fi
    fi

    if [[ $responded -eq 1 ]]; then
        HB_SERIAL_STATUS="$HB_SERIAL_NOT_PRESENT"
        HB_SERIAL_SOURCE="hardware-reports-none"
    else
        HB_SERIAL_STATUS="$HB_SERIAL_NOT_READ"
        HB_SERIAL_SOURCE="no-source-available"
    fi
    return 1
}

# macOS serial. The platform serial is a property, so read it as one rather
# than parsing a human-readable report whose labels change between releases.
# Sets HB_SERIAL_VALUE / HB_SERIAL_SOURCE / HB_SERIAL_STATUS.
hb_collect_serial_macos() {
    local responded=0
    local raw=""

    # Capture first and parse afterwards: piping straight into the parser would
    # hand back the parser's exit status, and a tool that failed outright would
    # then be counted as having answered.
    local tool_output=""

    if command -v ioreg >/dev/null 2>&1; then
        if tool_output=$(ioreg -d2 -c IOPlatformExpertDevice 2>/dev/null); then
            responded=1
            raw=$(_hb_serial_clean "$(printf '%s\n' "$tool_output" | hb_parse_ioreg_serial)")
            if is_usable_serial "$raw"; then
                HB_SERIAL_VALUE="$raw"
                HB_SERIAL_SOURCE="ioreg:IOPlatformSerialNumber"
                HB_SERIAL_STATUS="ok"
                return 0
            fi
        fi
    fi

    if command -v system_profiler >/dev/null 2>&1; then
        if tool_output=$(system_profiler SPHardwareDataType 2>/dev/null); then
            responded=1
            raw=$(_hb_serial_clean "$(printf '%s\n' "$tool_output" | hb_parse_system_profiler_serial)")
            if is_usable_serial "$raw"; then
                HB_SERIAL_VALUE="$raw"
                HB_SERIAL_SOURCE="system_profiler:SPHardwareDataType"
                HB_SERIAL_STATUS="ok"
                return 0
            fi
        fi
    fi

    if [[ $responded -eq 1 ]]; then
        HB_SERIAL_STATUS="$HB_SERIAL_NOT_PRESENT"
        HB_SERIAL_SOURCE="hardware-reports-none"
    else
        HB_SERIAL_STATUS="$HB_SERIAL_NOT_READ"
        HB_SERIAL_SOURCE="no-source-available"
    fi
    return 1
}

# Collect the hardware serial and write it to the output directory.
# Writes hardware-serial.txt (the serial, or one of the two not-found tokens)
# and hardware-serial-source.txt (which source produced it).
# Usage: collect_hardware_serial <output_dir>
# Returns: 0 when a usable serial was written, 1 otherwise
collect_hardware_serial() {
    local output_dir="$1"

    HB_SERIAL_VALUE=""
    HB_SERIAL_SOURCE=""
    HB_SERIAL_STATUS="$HB_SERIAL_NOT_READ"

    local platform="${HB_SERIAL_PLATFORM:-}"
    if [[ -z "$platform" ]]; then
        case "$(uname -s 2>/dev/null)" in
            Darwin) platform="macos" ;;
            Linux)  platform="linux" ;;
            *)      platform="unknown" ;;
        esac
    fi

    case "$platform" in
        linux) hb_collect_serial_linux ;;
        macos) hb_collect_serial_macos ;;
        *)
            HB_SERIAL_STATUS="$HB_SERIAL_NOT_READ"
            HB_SERIAL_SOURCE="unsupported-platform"
            ;;
    esac

    if [[ -n "$output_dir" && -d "$output_dir" ]]; then
        if [[ "$HB_SERIAL_STATUS" == "ok" ]]; then
            printf '%s\n' "$HB_SERIAL_VALUE" > "$output_dir/hardware-serial.txt"
        else
            printf '%s\n' "$HB_SERIAL_STATUS" > "$output_dir/hardware-serial.txt"
        fi
        printf '%s\n' "${HB_SERIAL_SOURCE:-unknown}" > "$output_dir/hardware-serial-source.txt"
    fi

    [[ "$HB_SERIAL_STATUS" == "ok" ]]
}

# One line for the operator, naming which of the two outcomes applies.
# Usage: hb_serial_report_line
hb_serial_report_line() {
    case "$HB_SERIAL_STATUS" in
        ok)
            echo "  ✅ Hardware serial: $HB_SERIAL_VALUE (source: $HB_SERIAL_SOURCE)"
            ;;
        "$HB_SERIAL_NOT_PRESENT")
            echo "  ⚠️  Hardware serial: none-present - the hardware reports no serial."
            echo "      Common on virtual machines. This asset needs a different key"
            echo "      in the register rather than a repair."
            ;;
        *)
            echo "  ❌ Hardware serial: could-not-read - no source returned a value."
            echo "      Checked /sys/class/dmi/id/product_serial, board_serial,"
            echo "      dmidecode and (on NixOS) nix run nixpkgs#dmidecode."
            echo "      The submission will be stored but stays unmatched."
            ;;
    esac
}

# Read the serial recorded in an output directory, for the report generators.
# Sets HB_SERIAL_VALUE / HB_SERIAL_SOURCE / HB_SERIAL_STATUS from the files.
# Archives written before this chain existed hold values such as "Not available"
# or a fragment of unrelated output; those become could-not-read, because at
# this distance there is no telling which of the two outcomes applied.
# Usage: read_recorded_serial <output_dir>
# Returns: 0 when a usable serial was recorded, 1 otherwise
read_recorded_serial() {
    local output_dir="$1"
    local raw=""

    HB_SERIAL_VALUE=""
    HB_SERIAL_SOURCE="unknown"
    HB_SERIAL_STATUS="$HB_SERIAL_NOT_READ"

    if [[ -f "$output_dir/hardware-serial-source.txt" ]]; then
        raw=$(_hb_serial_clean "$(cat "$output_dir/hardware-serial-source.txt" 2>/dev/null)")
        [[ -n "$raw" ]] && HB_SERIAL_SOURCE="$raw"
    fi

    if [[ ! -f "$output_dir/hardware-serial.txt" ]]; then
        return 1
    fi

    raw=$(_hb_serial_clean "$(cat "$output_dir/hardware-serial.txt" 2>/dev/null)")

    if is_usable_serial "$raw"; then
        HB_SERIAL_VALUE="$raw"
        HB_SERIAL_STATUS="ok"
        return 0
    fi

    if [[ "$raw" == "$HB_SERIAL_NOT_PRESENT" ]]; then
        HB_SERIAL_STATUS="$HB_SERIAL_NOT_PRESENT"
    else
        HB_SERIAL_STATUS="$HB_SERIAL_NOT_READ"
    fi
    return 1
}

# ==============================================================================
# AUDIT IDENTITY RESOLUTION
# ==============================================================================
#
# Who ran the audit, and when. Both used to be recovered by parsing them back
# out of the output directory's name, which is a lossy encoding: it joins
# hostname, username and date with "-" and lets all three contain "-". The old
# pattern - output-([^-]+)-([^-]+)-(.+)$ - could not span a hyphen, so every
# hyphenated hostname shifted the fields and named a user that does not exist
# on the machine.
#
# The username is not decoded any more. RUNME.sh runs fastfetch as the invoking
# user for exactly this purpose, so fastfetch.json's .user is the value the
# directory name was built from, recorded before the encoding lost it.

# Parse an audit output directory name into its three fields.
#
# Anchored on the DD-MM-YYYY suffix and taking the last hyphen-free segment
# before it as the username, which leaves the whole remainder as the hostname.
# That is correct for every real directory name we hold, including
# output-pankhuri-prakash-IdeaPad-5-14ARE05-root-02-04-2026. It is still wrong
# for a username containing a hyphen, which is why this is the last resort
# rather than the answer.
#
# Usage: hb_parse_output_dirname <dirname>
# Sets: HB_DIR_HOSTNAME / HB_DIR_USERNAME / HB_DIR_DATE
# Returns: 0 when the name parsed, 1 otherwise (all three left empty)
hb_parse_output_dirname() {
    local name="$1"

    HB_DIR_HOSTNAME=""
    HB_DIR_USERNAME=""
    HB_DIR_DATE=""

    if [[ "$name" =~ ^output-(.+)-([^-]+)-([0-9]{2}-[0-9]{2}-[0-9]{4})$ ]]; then
        # shellcheck disable=SC2034  # part of this function's contract; read by callers
        HB_DIR_HOSTNAME="${BASH_REMATCH[1]}"
        HB_DIR_USERNAME="${BASH_REMATCH[2]}"
        HB_DIR_DATE="${BASH_REMATCH[3]}"
        return 0
    fi

    return 1
}

# The directory's own name, without running basename(1). Pure expansion, so it
# works under a restricted PATH - which the test suite deliberately uses.
_hb_dir_basename() {
    local path="${1%/}"
    printf '%s' "${path##*/}"
}

# Print the username the audit recorded, on stdout.
#
# Order, each consulted only when the previous produced nothing:
#
#   1. fastfetch.json .user   what the audit recorded, run as the real user
#   2. the directory name     a directory whose fetch file is unreadable
#
# Returns 1 and prints nothing when no source answers, so the caller decides
# what an unknown user means instead of being handed a plausible default.
#
# Usage: hb_audit_username <output_dir>
hb_audit_username() {
    local output_dir="$1"
    local candidate=""
    local fetch_json="$output_dir/fastfetch.json"

    if [[ -f "$fetch_json" ]] && command -v jq >/dev/null 2>&1; then
        candidate=$(jq -r '.user // empty' "$fetch_json" 2>/dev/null)
        if [[ -n "$candidate" ]]; then
            printf '%s' "$candidate"
            return 0
        fi
    fi

    if hb_parse_output_dirname "$(_hb_dir_basename "$output_dir")"; then
        if [[ -n "$HB_DIR_USERNAME" ]]; then
            printf '%s' "$HB_DIR_USERNAME"
            return 0
        fi
    fi

    return 1
}

# Print the filename a report of the given kind should be written to.
#
# honeybadger-{user}-{date}-{kind}.md when both are known. When they are not,
# the run cannot be named after a person, so it is named after the kind and
# today's date rather than after a user we would be inventing.
#
# Usage: hb_report_basename <output_dir> <kind>
hb_report_basename() {
    local output_dir="$1" kind="$2"
    local username=""

    username=$(hb_audit_username "$output_dir") || username=""

    # hb_audit_username() leaves HB_DIR_DATE set only when it fell through to
    # the directory name, so parse explicitly rather than relying on that.
    hb_parse_output_dirname "$(_hb_dir_basename "$output_dir")" || true

    if [[ -n "$username" && -n "$HB_DIR_DATE" ]]; then
        printf 'honeybadger-%s-%s-%s.md' "$username" "$HB_DIR_DATE" "$kind"
        return 0
    fi

    printf 'honeybadger-%s-%s.md' "$kind" "$(date +%d-%m-%Y)"
}

