        echo "  Endpoint: $endpoint"
        echo "  Headers: X-Hostname=$hostname, X-Username=$username"
        echo "  Command: ${curl_cmd[*]}"
        return 0
    fi

    # Retry logic with exponential backoff
    local attempt=1
    local max_attempts=$SERVER_RETRY_COUNT

