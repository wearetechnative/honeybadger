# Server Report Submission Functions
# ==============================================================================

# Load server configuration from config file
# Checks in order: ./.honeybadger.conf, ~/.honeybadger.conf, /etc/honeybadger.conf
# Settings the client resolves, in the order they are reported.
HB_CONFIG_SETTINGS=(
    SERVER_ENABLED
    SERVER_URL
    SERVER_TOKEN
    SERVER_TIMEOUT
    SERVER_RETRY_COUNT
    DRY_RUN
    USE_DOCKER_CONVERTER
    MIN_HARDENING_SCORE
)

# Built-in defaults, used only where neither the environment nor a config file
# supplies a value. Read through indirect expansion in load_server_config,
# which shellcheck cannot follow.
# shellcheck disable=SC2034
HB_CONFIG_DEFAULT_SERVER_ENABLED="false"
HB_CONFIG_DEFAULT_SERVER_URL="http://localhost:7123/"
HB_CONFIG_DEFAULT_SERVER_TOKEN=""
HB_CONFIG_DEFAULT_SERVER_TIMEOUT="30"
HB_CONFIG_DEFAULT_SERVER_RETRY_COUNT="3"
HB_CONFIG_DEFAULT_DRY_RUN="false"
HB_CONFIG_DEFAULT_USE_DOCKER_CONVERTER="false"
HB_CONFIG_DEFAULT_MIN_HARDENING_SCORE="65"

# The minimum Lynis hardening score, as configured. This is the one place the
# number is declared; reports that show the score state it beside the score,
# because once it is configurable a report no longer implies its own norm.
# Usage: hb_min_hardening_score
hb_min_hardening_score() {
    local value="${MIN_HARDENING_SCORE:-$HB_CONFIG_DEFAULT_MIN_HARDENING_SCORE}"
    if [[ ! "$value" =~ ^[0-9]+$ ]]; then
        echo "WARNING: MIN_HARDENING_SCORE '$value' is not a number, using $HB_CONFIG_DEFAULT_MIN_HARDENING_SCORE" >&2
        value="$HB_CONFIG_DEFAULT_MIN_HARDENING_SCORE"
    fi
    echo "$value"
}

# Resolve the server settings.
#
# Precedence is environment, then config file, then built-in default. The file
# used to be sourced after the defaults were applied, which meant it always won
# and an environment variable could never take effect. That is not only
# inconvenient: DRY_RUN is a safety control, and it could not be switched on
# from the environment when the file had it off.
#
# Usage: load_server_config [config_file]
load_server_config() {
    local explicit="${1:-${HONEYBADGER_CONFIG:-}}"
    local name

    # Remember what the environment supplied, before the file can overwrite it.
    # ${!name+set} distinguishes unset from set-but-empty: exporting a setting
    # as an empty string is a choice, not an absence.
    local -a from_environment=()
    local -A environment_value=()
    for name in "${HB_CONFIG_SETTINGS[@]}"; do
        if [[ -n ${!name+set} ]]; then
            from_environment+=("$name")
            environment_value["$name"]="${!name}"
        fi
    done

    local loaded=""
    if [[ -n "$explicit" ]]; then
        # A named file is a deliberate choice. Falling back to the search order
        # when it is missing would submit somewhere the caller did not ask for.
        if [[ ! -f "$explicit" ]]; then
            echo "ERROR: Configuration file not found: $explicit" >&2
            return 1
        fi
        echo "Loading configuration from: $explicit"
        # shellcheck disable=SC1090
        source "$explicit"
        loaded="$explicit"
    else
        local config_file
        for config_file in "./.honeybadger.conf" "$HOME/.honeybadger.conf" "/etc/honeybadger.conf"; do
            if [[ -f "$config_file" ]]; then
                echo "Loading configuration from: $config_file"
                # shellcheck disable=SC1090
                source "$config_file"
                loaded="$config_file"
                break
            fi
        done
    fi

    # Put the environment back on top of whatever the file set.
    for name in "${from_environment[@]}"; do
        printf -v "$name" '%s' "${environment_value[$name]}"
    done

    # Anything neither source supplied falls back to the built-in default.
    for name in "${HB_CONFIG_SETTINGS[@]}"; do
        if [[ -z ${!name+set} ]]; then
            local default_var="HB_CONFIG_DEFAULT_${name}"
            printf -v "$name" '%s' "${!default_var}"
        fi
    done

    if [[ -z "$loaded" ]]; then
        echo "No configuration file found, using defaults"
        echo "  SERVER_ENABLED=$SERVER_ENABLED"
        echo "  SERVER_URL=$SERVER_URL"
    fi

    if [[ ${#from_environment[@]} -gt 0 ]]; then
        echo "From the environment (overriding the file): ${from_environment[*]}"
    fi

    return 0
}

# Find the most recent output-* directory
find_latest_output_dir() {
    local latest_dir
    latest_dir=$(ls -dt output-* 2>/dev/null | head -n 1)

    if [[ -z "$latest_dir" ]]; then
        echo "ERROR: No output-* directories found" >&2
        return 1
    fi

    echo "$latest_dir"
    return 0
}

# Find the most recent tar archive file
# Searches for honeybadger-*.tar.gz and honeybadger-*.tar files
find_latest_tar() {
    local latest_tar
    latest_tar=$(ls -t honeybadger-*.tar.gz honeybadger-*.tar 2>/dev/null | head -n 1)

    if [[ -z "$latest_tar" ]]; then
        echo "ERROR: No tar files found" >&2
        return 1
    fi

    echo "$latest_tar"
    return 0
}

# The reports the client submits, and the names both submission paths agree on.
# The tar path does not send these names itself - the server derives the report
# type from the file name inside the archive - so the file names here are the
# same ones the audit writes into the tarball, and a change to one is a change
# to both.
# File names the audit writes into the output directory, and the report types
# the collection server derives from them. The server reads the type from the
# member name inside the archive, so these two have to stay in step with what
# the audit produces.
HB_SYSINFO_REPORT_FILE="${HB_SYSINFO_REPORT_FILE:-fastfetch.json}"
HB_SYSINFO_REPORT_TYPE="${HB_SYSINFO_REPORT_TYPE:-fastfetch}"
HB_HARDENING_REPORT_FILE="${HB_HARDENING_REPORT_FILE:-lynis-report.json}"
HB_HARDENING_REPORT_TYPE="${HB_HARDENING_REPORT_TYPE:-lynis}"

# Classify a submission response so both submission paths decide the same way.
# Usage: classify_submission_response <http_code> <curl_exit>
# Echoes one of:
#   success      - stored, nothing to report
#   partial      - stored, but the server flagged something (207)
#   client-error - the request was wrong; retrying cannot help
#   retry        - transport failure or server-side error; worth another attempt
classify_submission_response() {
    local http_code="$1"
    local curl_exit="$2"

    if [[ "$curl_exit" -ne 0 ]]; then
        echo "retry"
        return 0
    fi

    case "$http_code" in
        207)         echo "partial" ;;
        2[0-9][0-9]) echo "success" ;;
        4[0-9][0-9]) echo "client-error" ;;
        *)           echo "retry" ;;
    esac
}

# Print what the server said about a submission. The single-report endpoint
# answers rejections with an http.server error page, so pull the one sentence
# that carries the reason out of it rather than printing the whole page.
# Usage: report_server_response <body_file>
report_server_response() {
    local body_file="$1"
    local body message

    [[ -s "$body_file" ]] || return 0

    body=$(tr -d '\r' < "$body_file" | head -c 2000)

    if [[ "$body" == *"<p>Message:"* ]]; then
        message=$(printf '%s' "$body" | sed -n 's|.*<p>Message: \(.*\)</p>.*|\1|p' | head -1)
        [[ -n "$message" ]] && body="$message"
    fi

    echo "  Server said: $body"
}

# Usage: submit_tar_file <tar_file_path>
submit_tar_file() {
    local tar_file="$1"

    # Validate file exists
    if [[ ! -f "$tar_file" ]]; then
        echo "ERROR: File not found: $tar_file" >&2
        return 1
    fi

    # Auto-detect system identity. The hostname is resolved from sources that
    # exist everywhere rather than from hostname(1), which Arch's base install
    # does not carry; a submission the server can only file under an empty name
    # is worse than one that did not arrive, so this stops instead.
    local hostname
    if ! hostname=$(hb_resolve_short_hostname); then
        echo "ERROR: could not determine this machine's hostname" >&2
        echo "  Tried: uname -n, \$HOSTNAME, /etc/hostname" >&2
        echo "  The hostname tells the server which machine the evidence" >&2
        echo "  belongs to, so the submission stops rather than arriving" >&2
        echo "  without one." >&2
        return 1
    fi
    local username
    username="${SUDO_USER:-$(whoami)}"

    # Build /submit-tar endpoint URL
    local endpoint="${SERVER_URL%/}/submit-tar"

    # Build curl command
    local curl_cmd=(
        curl
        -X POST
        "$endpoint"
        -H "Content-Type: application/x-tar"
        -H "X-Hostname: $hostname"
        -H "X-Username: $username"
    )

    # Add Authorization header if token is configured
    if [[ -n "$SERVER_TOKEN" ]]; then
        curl_cmd+=(-H "Authorization: Bearer $SERVER_TOKEN")
    fi

    local body_file
    body_file=$(mktemp "${TMPDIR:-/tmp}/honeybadger-submit-tar-XXXXXX")

    curl_cmd+=(
        --max-time "$SERVER_TIMEOUT"
        --silent
        --show-error
        --write-out "%{http_code}"
        --output "$body_file"
        --data-binary "@$tar_file"
    )

    # Dry-run mode
    if [[ "$DRY_RUN" == "true" ]]; then
        echo "DRY-RUN: Would submit tar file"
        echo "  File: $tar_file"
        echo "  Endpoint: $endpoint"
        echo "  Headers: X-Hostname=$hostname, X-Username=$username"
        echo "  Command: ${curl_cmd[*]}"
        rm -f "$body_file"
        return 0
    fi

    # Retry logic with exponential backoff. One exit path, so the captured
    # response body is always cleaned up.
    local attempt=1
    local max_attempts=$SERVER_RETRY_COUNT
    local status=1

    while [[ $attempt -le $max_attempts ]]; do
        echo "Submitting tar file (attempt $attempt/$max_attempts)..."

        local http_code
        http_code=$("${curl_cmd[@]}" 2>&1)
        local curl_exit=$?

        local outcome
        outcome=$(classify_submission_response "$http_code" "$curl_exit")

        if [[ "$outcome" == "success" ]]; then
            echo "✓ Successfully submitted tar file: $tar_file"
            status=0
            break
        fi

        if [[ "$outcome" == "partial" ]]; then
            # 207: the archive is stored. The server could not match it to an
            # asset register entry, or did not recognise every member.
            # Resending would only store it twice.
            echo "✓ Submitted tar file: $tar_file (HTTP $http_code, partial - the server stored it with a remark)"
            report_server_response "$body_file"
            status=0
            break
        fi

        if [[ "$outcome" == "client-error" ]]; then
            echo "✗ Failed to submit tar file: HTTP $http_code (client error, not retrying)" >&2
            report_server_response "$body_file" >&2
            status=1
            break
        fi

        # Log failure and retry if attempts remaining
        if [[ $attempt -lt $max_attempts ]]; then
            local delay=$((2 ** (attempt - 1)))  # Exponential backoff: 1s, 2s, 4s
            echo "  Failed (HTTP $http_code, curl exit $curl_exit), retrying in ${delay}s..."
            sleep "$delay"
        else
            echo "✗ Failed to submit tar file after $max_attempts attempts (HTTP $http_code, curl exit $curl_exit)" >&2
            report_server_response "$body_file" >&2
            status=1
        fi

        ((attempt++))
    done

    rm -f "$body_file"
    return $status
}


# ==============================================================================
# ISO27001 COMPLIANCE CHECK FUNCTIONS
# ==============================================================================

# ------------------------------------------------------------------------------
# The check_* functions are the only place a compliance verdict is formed. Every
# report calls them, and none of them reads an evidence file to decide pass or
# fail for itself.
#
# Each prints a detail string for a human and returns its verdict:
#   0  the control is in place
#   1  the evidence shows it is not
#   2  no sufficient evidence was collected to tell
#
# A caller may reformat the detail string. It may not re-derive the verdict
# from it: the exit code is the verdict, and the detail is the reason.
# "Encryption is off" and "we could not see whether encryption is on" are
# different findings, and only the first is a blocker.
# ------------------------------------------------------------------------------

# Check disk encryption status from blockdevices.txt
# Usage: check_disk_encryption <output_dir>
# Prints: "Yes (LUKS)" | "Yes (LUKS2)" | "No" | "Unknown - ..."
check_disk_encryption() {
    local output_dir="$1"
    local blockdevices_file="$output_dir/blockdevices.txt"

    if [[ ! -f "$blockdevices_file" ]]; then
        echo "Unknown - blockdevices.txt not collected"
        return 2
    fi

    if grep -q "crypto_LUKS" "$blockdevices_file"; then
        # Check if LUKS2 specifically
        if grep -q "crypto_LUKS 2" "$blockdevices_file"; then
            echo "Yes (LUKS2)"
        else
            echo "Yes (LUKS)"
        fi
        return 0
    else
        echo "No"
        return 1
    fi
}

# Screen lock limit, in seconds. ISO27001 policy: locked within 15 minutes.
HB_SCREEN_LOCK_LIMIT_SECONDS=900

# Choose the mechanism a screen lock verdict rests on, and write the closing
# summary block of screenlock-info.txt.
#
# The evidence file can hold AUTO-LOCK-STATUS lines from half a dozen
# mechanisms, and some of them answer for nobody: GNOME's schemas are installed
# as a dependency on machines that never run GNOME, and gsettings reads them
# happily. Only the device knows at scan time what was actually running, so the
# choice is made here, at collection, and written down.
#
# Rank, most to least authoritative:
#   1  a lock daemon that is running, timeout read from its own arguments
#   2  a lock daemon that is running, timeout read from its configuration
#   3  settings of the active desktop environment
#   4  settings of a desktop environment that is not the active one
#
# A running daemon whose timeout cannot be read is still the mechanism: the
# honest outcome is "enforced by X, timeout undetermined", not a figure lifted
# from settings nothing is reading. Rank 4 is recorded but never trusted.
#
# Reads, all optional:
#   SL_ACTIVE_DE          GNOME | KDE | XFCE | Hyprland | sway | ... (empty: unknown)
#   SL_ACTIVE_DE_BASIS    how SL_ACTIVE_DE was established
#   SL_RUNNING            space-separated running daemons, in the order found
#   SL_ARGS_SECONDS_<d>   timeout from daemon <d>'s own arguments
#   SL_CONF_SECONDS_<d>   timeout from daemon <d>'s configuration
#   SL_CONF_SOURCE_<d>    where that configuration was read
#   SL_DE_STATUS_<de>     ENABLED | DISABLED, for GNOME, KDE, XFCE
#   SL_DE_SECONDS_<de>    that desktop's total time to lock
# (daemon names with "-" use "_" in the variable name, e.g. xss_lock)
#
# Usage: hb_screen_lock_summary
hb_screen_lock_summary() {
    local limit="$HB_SCREEN_LOCK_LIMIT_SECONDS"
    local mechanism="none" rank="none" rule="" basis="" seconds="" status="NONE"
    local d var

    _hb_sl_gate() {
        if (( $1 <= limit )); then echo "ENABLED"; else echo "TIMEOUT-TOO-LONG"; fi
    }

    # Ranks 1 and 2: a running daemon. Prefer one whose timeout is known.
    for d in ${SL_RUNNING:-}; do
        var="SL_ARGS_SECONDS_${d//-/_}"
        if [[ -n "${!var:-}" ]]; then
            mechanism="$d"; rank=1; rule="daemon running, timeout from its arguments"
            seconds="${!var}"; basis="$d is running with a timeout of ${seconds}s in its arguments"
            break
        fi
    done
    if [[ "$mechanism" == "none" ]]; then
        for d in ${SL_RUNNING:-}; do
            var="SL_CONF_SECONDS_${d//-/_}"
            if [[ -n "${!var:-}" ]]; then
                local src_var="SL_CONF_SOURCE_${d//-/_}"
                mechanism="$d"; rank=2; rule="daemon running, timeout from its configuration"
                seconds="${!var}"; basis="$d is running; ${seconds}s read from ${!src_var:-its configuration}"
                break
            fi
        done
    fi
    if [[ "$mechanism" == "none" && -n "${SL_RUNNING:-}" ]]; then
        d="${SL_RUNNING%% *}"
        mechanism="$d"; rank=1; rule="daemon running"
        basis="$d is running; no timeout found in its arguments or its configuration"
        status="UNDETERMINED"
    fi

    # Rank 3: the active desktop's own settings.
    local de de_status_var de_seconds_var
    if [[ "$mechanism" == "none" && -n "${SL_ACTIVE_DE:-}" ]]; then
        for de in GNOME KDE XFCE; do
            [[ "${SL_ACTIVE_DE^^}" == *"$de"* ]] || continue
            de_status_var="SL_DE_STATUS_$de"; de_seconds_var="SL_DE_SECONDS_$de"
            [[ -n "${!de_status_var:-}" ]] || continue
            mechanism="$de settings"; rank=3; rule="settings of the active desktop"
            basis="$de is the active desktop (${SL_ACTIVE_DE_BASIS:-basis not recorded})"
            if [[ "${!de_status_var}" == "DISABLED" ]]; then
                status="DISABLED"
            elif [[ -n "${!de_seconds_var:-}" ]]; then
                seconds="${!de_seconds_var}"
            else
                status="UNDETERMINED"; basis+="; lock enabled but no timeout read"
            fi
            break
        done
    fi

    # Rank 4: another desktop's settings. Recorded, never trusted.
    if [[ "$mechanism" == "none" ]]; then
        for de in GNOME KDE XFCE; do
            de_status_var="SL_DE_STATUS_$de"; de_seconds_var="SL_DE_SECONDS_$de"
            [[ -n "${!de_status_var:-}" ]] || continue
            mechanism="$de settings"; rank=4; rule="settings of a desktop that is not active"
            basis="$de settings are present, but $de is not the active desktop"
            basis+=" (active: ${SL_ACTIVE_DE:-not established}); nothing shows they are enforced"
            status="UNDETERMINED"
            break
        done
    fi

    if [[ -n "$seconds" && "$status" == "NONE" ]]; then
        status=$(_hb_sl_gate "$seconds")
    fi
    [[ "$mechanism" == "none" ]] && basis="no running lock daemon and no desktop lock settings found"

    echo "=== Authoritative Source Summary ==="
    echo "SUMMARY-ACTIVE-DESKTOP: ${SL_ACTIVE_DE:-not established}${SL_ACTIVE_DE_BASIS:+ (${SL_ACTIVE_DE_BASIS})}"
    echo "SUMMARY-MECHANISM: $mechanism"
    echo "SUMMARY-RANK: $rank${rule:+ ($rule)}"
    echo "SUMMARY-BASIS: $basis"
    echo "SUMMARY-TIMEOUT-SECONDS: ${seconds:-undetermined}"
    echo "SUMMARY-LIMIT-SECONDS: $limit"
    echo "SUMMARY-STATUS: $status"
}

# Render a number of seconds as the unit a person would say.
# Usage: _hb_duration <seconds>
_hb_duration() {
    local seconds="$1"
    if (( seconds % 60 == 0 )); then
        local minutes=$(( seconds / 60 ))
        (( minutes == 1 )) && echo "1 minute" || echo "$minutes minutes"
    else
        echo "$seconds seconds"
    fi
}

# Check screen lock status from screenlock-info.txt
# Usage: check_screen_lock_status <output_dir>
# Prints a detail string naming the mechanism the verdict rests on.
# Exit code: 0 locked within the limit, 1 disabled or too slow, 2 not established
#
# The verdict comes from the summary block the collector writes last (see
# hb_screen_lock_summary). A file collected before that block existed is still
# evaluated the old way - first ENABLED anywhere, then the limit - and says that
# its source could not be established.
check_screen_lock_status() {
    local output_dir="$1"
    local screenlock_file="$output_dir/screenlock-info.txt"
    local limit_minutes=$(( HB_SCREEN_LOCK_LIMIT_SECONDS / 60 ))

    if [[ ! -f "$screenlock_file" ]]; then
        echo "Unknown - screenlock-info.txt not collected"
        return 2
    fi

    if grep -q "^SUMMARY-STATUS:" "$screenlock_file"; then
        local status mechanism rank seconds
        status=$(grep -m1 "^SUMMARY-STATUS:" "$screenlock_file" | sed 's/^SUMMARY-STATUS: *//')
        mechanism=$(grep -m1 "^SUMMARY-MECHANISM:" "$screenlock_file" | sed 's/^SUMMARY-MECHANISM: *//')
        rank=$(grep -m1 "^SUMMARY-RANK:" "$screenlock_file" | sed 's/^SUMMARY-RANK: *//; s/ .*//')
        seconds=$(grep -m1 "^SUMMARY-TIMEOUT-SECONDS:" "$screenlock_file" | sed 's/^SUMMARY-TIMEOUT-SECONDS: *//')

        case "$status" in
            ENABLED)
                echo "Yes (Auto-lock: $(_hb_duration "$seconds"), $mechanism)"
                return 0
                ;;
            TIMEOUT-TOO-LONG)
                echo "Timeout too long ($(_hb_duration "$seconds"), $mechanism; limit $limit_minutes minutes)"
                return 1
                ;;
            DISABLED)
                echo "Disabled ($mechanism)"
                return 1
                ;;
            UNDETERMINED)
                if [[ "$rank" == "4" ]]; then
                    echo "Unknown - only $mechanism found, and that desktop is not the active one"
                else
                    echo "Auto-lock enforced by $mechanism, timeout could not be established"
                fi
                return 2
                ;;
            *)
                echo "Unknown - no auto-lock mechanism found"
                return 2
                ;;
        esac
    fi

    # Collected before the summary block existed.
    local unsourced="source not established"
    if grep -q "AUTO-LOCK-STATUS: ENABLED" "$screenlock_file"; then
        # Extract timeout in minutes
        local timeout_line=$(grep "Total time until auto-lock:" "$screenlock_file" | grep -oP '\([0-9]+ minutes\)' | tr -d '()')
        if [[ -z "$timeout_line" ]]; then
            timeout_line=$(grep "Auto-lock timeout:" "$screenlock_file" | grep -oP '[0-9]+ minutes' | head -1)
        fi

        if [[ -n "$timeout_line" ]]; then
            local minutes=$(echo "$timeout_line" | grep -oP '[0-9]+')
            if [[ $minutes -le $limit_minutes ]]; then
                echo "Yes (Auto-lock: $timeout_line; $unsourced)"
                return 0
            else
                echo "Timeout too long ($timeout_line; $unsourced; limit $limit_minutes minutes)"
                return 1
            fi
        else
            echo "Yes (Auto-lock enabled; $unsourced)"
            return 0
        fi
    else
        echo "Disabled ($unsourced)"
        return 1
    fi
}

# Check for active iptables firewall rules
# Usage: check_iptables_firewall
# Returns: 0 if active firewall detected, 1 otherwise
# Sets HB_IPTABLES_DETAIL to "nixos-fw chain" when that is what was found.
# Detects: NixOS nixos-fw chain + generic non-empty iptables rulesets
#
# Runs during the audit, as root. Evaluation never calls it: a probe at
# check-output time would describe the analysing machine, not the audited one.
check_iptables_firewall() {
    HB_IPTABLES_DETAIL=""

    # Check if iptables command is available
    if ! command -v iptables >/dev/null 2>&1; then
        return 1
    fi

    # Check for NixOS nixos-fw chain (common on NixOS systems)
    if iptables -L nixos-fw -n >/dev/null 2>&1; then
        local nixos_fw_rules
        nixos_fw_rules=$(iptables -L nixos-fw -n 2>/dev/null | grep -v "^Chain" | grep -vc "^target")
        if [[ $nixos_fw_rules -gt 0 ]]; then
            HB_IPTABLES_DETAIL="nixos-fw chain"
            return 0  # Active NixOS firewall detected
        fi
    fi

    # Check for generic iptables rules (non-default chains or rules)
    # Look for INPUT chain with actual rules (not just policy)
    local input_rules
    input_rules=$(iptables -L INPUT -n 2>/dev/null | grep -v "^Chain" | grep -vc "^target")
    if [[ $input_rules -gt 0 ]]; then
        return 0  # Active iptables rules detected
    fi

    return 1  # No active firewall detected
}

# Check for active nftables firewall rules
# Usage: check_nftables_firewall
# Returns: 0 if active firewall detected, 1 otherwise
# Runs during the audit, as root - see check_iptables_firewall.
check_nftables_firewall() {
    # Check if nft command is available
    if ! command -v nft >/dev/null 2>&1; then
        return 1
    fi

    # Check for any nftables ruleset
    local nft_rules
    nft_rules=$(nft list ruleset 2>/dev/null | grep -vc "^$")
    if [[ $nft_rules -gt 0 ]]; then
        return 0  # Active nftables rules detected
    fi

    return 1  # No active nftables detected
}

# Write the firewall evidence for firewall-info.txt: the rulesets as the tools
# report them, so a reader can check the conclusion, and a closing result line,
# so evaluation does not have to re-derive it from a ruleset dump.
#
# FIREWALL-RULESET is one of:
#   ACTIVE (<tool>[, <detail>])   an active ruleset was found
#   NONE                          the tools were queried and found none
#   UNAVAILABLE                   neither iptables nor nft is installed
#
# Usage: hb_collect_firewall_evidence > "$output/firewall-info.txt"
hb_collect_firewall_evidence() {
    local -a queried=()

    echo "=== iptables ==="
    if command -v iptables >/dev/null 2>&1; then
        queried+=(iptables)
        iptables -S 2>&1 || echo "(iptables -S failed)"
    else
        echo "iptables not installed"
    fi
    echo ""

    echo "=== nftables ==="
    if command -v nft >/dev/null 2>&1; then
        queried+=(nft)
        nft list ruleset 2>&1 || echo "(nft list ruleset failed)"
    else
        echo "nft not installed"
    fi
    echo ""

    local result
    if check_iptables_firewall; then
        result="ACTIVE (iptables${HB_IPTABLES_DETAIL:+, $HB_IPTABLES_DETAIL})"
    elif check_nftables_firewall; then
        result="ACTIVE (nftables)"
    elif (( ${#queried[@]} == 0 )); then
        result="UNAVAILABLE"
    else
        result="NONE"
    fi

    echo "=== Result ==="
    echo "FIREWALL-TOOLS-QUERIED: ${queried[*]:-none}"
    echo "FIREWALL-RULESET: $result"
}

# Check firewall status from the evidence the audit collected
# Usage: check_firewall_status <output_dir>
# Prints: "Yes (<tool>)" | "Yes" | "No" | "Unknown - ..."
# Exit code: 0 firewall active, 1 established absent, 2 could not be established
#
# Evidence, in order: the ruleset recorded in firewall-info.txt, then Lynis
# firewall_active. Nothing is probed here - see design.md of
# collect-evidence-as-the-session-user for the table this implements.
#
# Lynis does not recognise the NixOS nixos-fw chain. So a Lynis "0" on its own,
# in an archive collected before firewall-info.txt existed, is not evidence of
# a missing firewall, and is reported as not established.
check_firewall_status() {
    local output_dir="$1"
    local lynis_file="$output_dir/lynis-report.json"
    local evidence_file="$output_dir/firewall-info.txt"
    local ruleset="" lynis_active=""

    if [[ -f "$evidence_file" ]]; then
        ruleset=$(grep -m1 "^FIREWALL-RULESET:" "$evidence_file" | sed 's/^FIREWALL-RULESET: *//')
    fi
    if [[ -f "$lynis_file" ]] && command -v jq >/dev/null 2>&1 \
        && jq -e . "$lynis_file" >/dev/null 2>&1; then
        lynis_active=$(jq -r '.firewall_active // "0"' "$lynis_file" 2>/dev/null)
    fi

    if [[ "$ruleset" == ACTIVE* ]]; then
        echo "Yes ${ruleset#ACTIVE }"
        return 0
    fi
    if [[ "$lynis_active" == "1" ]]; then
        echo "Yes"
        return 0
    fi
    # The tools looked on the device and found no ruleset.
    if [[ "$ruleset" == "NONE" ]]; then
        echo "No"
        return 1
    fi
    if [[ -n "$ruleset" && "$lynis_active" == "0" ]]; then
        echo "No"
        return 1
    fi
    if [[ -n "$ruleset" ]]; then
        echo "Unknown - no packet filter tool on the device and lynis-report.json not available"
        return 2
    fi
    if [[ "$lynis_active" == "0" ]]; then
        echo "Unknown - Lynis found no firewall, and no firewall-info.txt was collected to check it against"
        return 2
    fi

    echo "Unknown - neither firewall-info.txt nor lynis-report.json available"
    return 2
}

# Detect if system is NixOS
# Usage: is_nixos <output_dir>
# Returns: 0 if NixOS, 1 otherwise
is_nixos() {
    local output_dir="$1"

    # Check lynis-report.json first (most authoritative)
    if [[ -f "$output_dir/lynis-report.json" ]] && command -v jq >/dev/null 2>&1; then
        local os_name=$(jq -r '.os_name // ""' "$output_dir/lynis-report.json" 2>/dev/null)
        if [[ "$os_name" =~ "NixOS" ]]; then
            return 0
        fi
    fi

    # Fallback: check fastfetch.json
    local _os_json="$output_dir/fastfetch.json"
    if [[ -f "$_os_json" ]] && command -v jq >/dev/null 2>&1; then
        local os=$(jq -r '.os // ""' "$_os_json" 2>/dev/null)
        if [[ "$os" =~ "NixOS" ]]; then
            return 0
        fi
    fi

    return 1
}

# Check NixOS supply chain security status
# Usage: check_nixos_supply_chain <output_dir>
# Returns: Status string (PASS/FAIL/Unknown)
# Exit code: 0 if PASS, 1 if FAIL, 2 if Unknown
#
# Also sets global variables for detailed reporting:
#   NIXOS_SUPPLY_CHAIN_STATUS - PASS/FAIL/Unknown
#   NIXOS_SUPPLY_CHAIN_ISSUES - Array of failure reasons (if FAIL)
#   NIXOS_SUPPLY_CHAIN_STORE_OK - true/false/unknown (store integrity)
check_nixos_supply_chain() {
    local output_dir="$1"
    local audit_file="$output_dir/nix-supply-chain-audit.txt"

    # Return Unknown if audit file doesn't exist
    if [[ ! -f "$audit_file" ]]; then
        NIXOS_SUPPLY_CHAIN_STATUS="Unknown"
        NIXOS_SUPPLY_CHAIN_ISSUES=()
        NIXOS_SUPPLY_CHAIN_STORE_OK="unknown"
        echo "Unknown"
        return 2
    fi

    # Parse result from audit output
    if grep -q "Result: PASS" "$audit_file" 2>/dev/null; then
        NIXOS_SUPPLY_CHAIN_STATUS="PASS"
        NIXOS_SUPPLY_CHAIN_ISSUES=()

        # Extract store integrity status
        if grep -q "Store integrity: OK" "$audit_file" 2>/dev/null; then
            NIXOS_SUPPLY_CHAIN_STORE_OK="true"
        else
            NIXOS_SUPPLY_CHAIN_STORE_OK="false"
        fi

        echo "PASS"
        return 0

    elif grep -q "Result: FAIL" "$audit_file" 2>/dev/null; then
        NIXOS_SUPPLY_CHAIN_STATUS="FAIL"

        # Extract failure reasons from "Issues identified:" section
        NIXOS_SUPPLY_CHAIN_ISSUES=()
        local in_issues=false
        while IFS= read -r line; do
            if [[ "$line" =~ "Issues identified:" ]]; then
                in_issues=true
                continue
            fi
            if $in_issues; then
                # Stop at empty line or next section
                if [[ -z "$line" ]] || [[ "$line" =~ ^=== ]]; then
                    break
                fi
                # Extract issue (remove leading "- ")
                local issue=$(echo "$line" | sed 's/^- //')
                if [[ -n "$issue" ]]; then
                    NIXOS_SUPPLY_CHAIN_ISSUES+=("$issue")
                fi
            fi
        done < "$audit_file"

        # Extract store integrity status
        if grep -q "Store integrity: OK" "$audit_file" 2>/dev/null; then
            NIXOS_SUPPLY_CHAIN_STORE_OK="true"
        elif grep -q "Store integrity: WARNING" "$audit_file" 2>/dev/null; then
            NIXOS_SUPPLY_CHAIN_STORE_OK="false"
        else
            NIXOS_SUPPLY_CHAIN_STORE_OK="unknown"
        fi

        echo "FAIL"
        return 1
    else
        NIXOS_SUPPLY_CHAIN_STATUS="Unknown"
        NIXOS_SUPPLY_CHAIN_ISSUES=()
        NIXOS_SUPPLY_CHAIN_STORE_OK="unknown"
        echo "Unknown"
        return 2
    fi
}

# Check hardening score from lynis-report.json
# Usage: check_hardening_score <output_dir>
# Returns: score value (0-100) or "Unknown"
# Exit code: always 0 (informational only, no pass/fail)
check_hardening_score() {
    local output_dir="$1"
    local lynis_file="$output_dir/lynis-report.json"

    if [[ ! -f "$lynis_file" ]] || ! command -v jq >/dev/null 2>&1; then
        echo "Unknown"
        return 0
    fi

    local score=$(jq -r '.hardening_index // "Unknown"' "$lynis_file" 2>/dev/null)

    if [[ "$score" == "Unknown" ]] || [[ ! "$score" =~ ^[0-9]+$ ]]; then
        echo "Unknown"
        return 0
    fi

    echo "$score"
    return 0
}

# Check for vulnerable packages from lynis-report.json
# Usage: check_vulnerable_packages <output_dir>
# Prints: "None (<tool>)" | "<n> vulnerable packages found (<tool>)" |
#         "Yes - Lynis warning PKGS-7392" | "Unknown - ..."
#
# Absence of a PKGS-7392 warning only means something when a package audit tool
# looked. Without one Lynis raises PKGS-7398 and reports zero, and reading that
# as "no vulnerable packages" would file a machine nobody checked as clean.
#
# Lynis has written warnings both as "ID|text|..." strings and as objects with
# an "id"; both are matched.
check_vulnerable_packages() {
    local output_dir="$1"
    local lynis_file="$output_dir/lynis-report.json"

    if [[ ! -f "$lynis_file" ]]; then
        echo "Unknown - lynis-report.json not collected"
        return 2
    fi
    if ! command -v jq >/dev/null 2>&1; then
        echo "Unknown - jq not available to read lynis-report.json"
        return 2
    fi
    if ! jq -e . "$lynis_file" >/dev/null 2>&1; then
        echo "Unknown - lynis-report.json is not readable"
        return 2
    fi

    local audit_tool tool_name count has_pkgs_7392
    audit_tool=$(jq -r '.package_audit_tool_found // "0"' "$lynis_file")
    tool_name=$(jq -r '.package_audit_tool // "package audit tool"' "$lynis_file")
    count=$(jq -r '.vulnerable_packages_found // "0"' "$lynis_file")
    has_pkgs_7392=$(jq -r '[.["warning[]"][]?
        | (if type == "object" then .id else (tostring | split("|")[0]) end)
        | select(. == "PKGS-7392")] | length' "$lynis_file")

    if [[ "$audit_tool" != "1" ]]; then
        echo "Unknown - no package audit tool present (PKGS-7398)"
        return 2
    fi

    if [[ "$count" =~ ^[0-9]+$ ]] && (( count > 0 )); then
        echo "$count vulnerable packages found ($tool_name)"
        return 1
    fi
    if [[ "$has_pkgs_7392" != "0" ]]; then
        echo "Yes - Lynis warning PKGS-7392"
        return 1
    fi

    echo "None ($tool_name)"
    return 0
}

# Check if a Lynis scan was run
# Usage: check_lynis_scan_exists <output_dir>
# Prints: "Yes" | "No" | "Unknown - ..."
#
# Here the absent file is itself the finding: the scan produces it, so no file
# means no scan. A file that is there but cannot be read shows that a scan
# started, not that it completed.
check_lynis_scan_exists() {
    local output_dir="$1"
    local lynis_file="$output_dir/lynis-report.json"

    if [[ ! -f "$lynis_file" ]]; then
        echo "No"
        return 1
    fi

    if command -v jq >/dev/null 2>&1 && ! jq -e . "$lynis_file" >/dev/null 2>&1; then
        echo "Unknown - lynis-report.json is present but not readable"
        return 2
    fi

    echo "Yes"
    return 0
}

# Check whether the OS release is still supported, from os-kernel-status.txt
# Usage: check_os_uptodate <output_dir>
# Prints: "Yes (Current)" | "Supported (Upgrade recommended)" | "No (EOL)" | "Unknown - ..."
#
# Three outcomes onto a pass or fail: supported but not the newest release
# counts as up to date. Only end of life fails.
check_os_uptodate() {
    local output_dir="$1"
    local status_file="$output_dir/os-kernel-status.txt"

    if [[ ! -f "$status_file" ]]; then
        echo "Unknown - os-kernel-status.txt not collected"
        return 2
    fi

    if grep -q "Result: ✓ PASS" "$status_file"; then
        echo "Yes (Current)"
        return 0
    elif grep -q "Result: ⚠ WARNING" "$status_file"; then
        echo "Supported (Upgrade recommended)"
        return 0
    elif grep -q "Result: ✗ FAIL" "$status_file"; then
        echo "No (EOL)"
        return 1
    fi

    echo "Unknown - no recognisable result in os-kernel-status.txt"
    return 2
}

# ==============================================================================
# LYNIS SEVERITY CLASSIFICATION FUNCTIONS
# ==============================================================================

# Classify Lynis finding by severity level using keyword-based matching
# Usage: classify_lynis_severity <test_id> <finding_type> <description>
# Arguments:
#   test_id: Lynis test ID (e.g., "PKGS-7392")
#   finding_type: "warning" or "suggestion"
#   description: Finding description text
# Returns: "CRITICAL" | "HIGH" | "MEDIUM" | "LOW"
#
# Severity mapping (ISO27001, NIST, vulnerability management best practices):
# - CRITICAL: Immediate security risk, fix binnen 1 week
#   * Test ID PKGS-7392 (vulnerable packages)
#   * Warnings with critical keywords
# - HIGH: Security-impacting, fix binnen 1 week
#   * All other warnings
#   * Suggestions with high-priority keywords
# - MEDIUM: Configuration hardening, fix binnen 1 maand
#   * Default for suggestions
# - LOW: Optional improvements, best effort
#   * Suggestions with low-priority keywords
classify_lynis_severity() {
    local test_id="$1"
    local finding_type="$2"
    local description="$3"

    # Convert to lowercase for case-insensitive matching
    local desc_lower=$(echo "$description" | tr '[:upper:]' '[:lower:]')

    # CRITICAL: Known critical test IDs
    if [[ "$test_id" == "PKGS-7392" ]]; then
        echo "CRITICAL"
        return 0
    fi

    # CRITICAL: Warnings with critical keywords
    if [[ "$finding_type" == "warning" ]]; then
        if matches_keywords "$desc_lower" "vulnerable unpatched outdated exposed no_encryption no_firewall authentication_failed"; then
            echo "CRITICAL"
            return 0
        fi
        # All other warnings are HIGH
        echo "HIGH"
        return 0
    fi

    # For suggestions: check keyword patterns
    if [[ "$finding_type" == "suggestion" ]]; then
        # LOW: Low-priority keywords
        if matches_keywords "$desc_lower" "consider optional recommended"; then
            echo "LOW"
            return 0
        fi

        # HIGH: High-priority keywords
        if matches_keywords "$desc_lower" "kernel ssh remote permissions access_control update patch"; then
            echo "HIGH"
            return 0
        fi

        # MEDIUM: Default for suggestions
        echo "MEDIUM"
        return 0
    fi

    # Fallback
    echo "MEDIUM"
    return 0
}

# Helper function for case-insensitive keyword matching
# Usage: matches_keywords <text> <keywords>
# Arguments:
#   text: Lowercase text to search in
#   keywords: Space-separated list of keywords (use underscore for spaces in keywords)
# Returns: 0 if any keyword matches, 1 otherwise
matches_keywords() {
    local text="$1"
    local keywords="$2"

    # Convert keywords to array
    local keyword_array=($keywords)

    for keyword in "${keyword_array[@]}"; do
        # Replace underscore with space for multi-word keywords
        local pattern="${keyword//_/ }"

        if echo "$text" | grep -q "$pattern"; then
            return 0
        fi
    done

    return 1
}

