# Generate Lynis security actions report organized by severity
# Usage: generate_lynis_actions_report <output_dir>
# Generates: honeybadger-{user}-{date}-actions.md
generate_lynis_actions_report() {
    local output_dir="$1"

    if [[ ! -d "$output_dir" ]]; then
        echo "ERROR: Directory $output_dir does not exist" >&2
        return 1
    fi

    local lynis_file="$output_dir/lynis-report.json"
    if [[ ! -f "$lynis_file" ]] || ! command -v jq >/dev/null 2>&1; then
        echo "ERROR: lynis-report.json not found or jq not available" >&2
        return 1
    fi

    local report_file
    report_file=$(hb_report_basename "$output_dir" actions)

    # Get metadata
    local hostname=$(jq -r '.hostname // "Unknown"' "$lynis_file" 2>/dev/null)
    local scan_date=$(jq -r '.report_datetime_start // "Unknown"' "$lynis_file" 2>/dev/null)

    # Extract warnings and suggestions
    local temp_findings="/tmp/lynis-findings-$$.json"

    # warning[] holds one object per warning ({id, description, ...}).
    # Reports produced before that fix stored the raw pipe-separated form, either
    # as one string per warning or - for a single warning - split across the array;
    # both legacy shapes are normalised here so older tarballs keep working.
    jq -r '
        def warnings:
            (.["warning[]"] // []) as $w
            | if ($w | length) == 0 then []
              elif (($w[0] | type) == "object") then
                  $w | map({id: (.id // ""), description: (.description // "")})
              elif ($w | map(select((type == "string") and test("\\|"))) | length) > 0 then
                  $w | map(select((type == "string") and test("\\|")) | split("|"))
                     | map({id: (.[0] // ""), description: (.[1] // "")})
              else
                  [{id: ($w[0] // ""), description: ($w[1] // "")}]
              end;
        (warnings | map({
            test_id: (.id | if . == "" then "UNKNOWN" else . end),
            type: "warning",
            description: .description
        })) +
        ((.["suggestion[]"] // []) | to_entries | map({
            test_id: .value.id // (.key | tostring),
            type: "suggestion",
            description: .value.description // .value
        }))
    ' "$lynis_file" > "$temp_findings" 2>/dev/null

    # Classify findings by severity
    declare -A severity_counts
    declare -A severity_findings
    severity_counts[CRITICAL]=0
    severity_counts[HIGH]=0
    severity_counts[MEDIUM]=0
    severity_counts[LOW]=0

    while IFS= read -r finding; do
        local test_id=$(echo "$finding" | jq -r '.test_id')
        local type=$(echo "$finding" | jq -r '.type')
        local description=$(echo "$finding" | jq -r '.description')

        local severity=$(classify_lynis_severity "$test_id" "$type" "$description")

        severity_counts[$severity]=$((${severity_counts[$severity]} + 1))
        severity_findings[$severity]+="$finding"$'\n'
    done < <(jq -c '.[]' "$temp_findings" 2>/dev/null)

    # Only report CRITICAL and HIGH (exclude MEDIUM and LOW for focus)
    local total=$((${severity_counts[CRITICAL]} + ${severity_counts[HIGH]}))
    local total_noun="acties"
    if [[ $total -eq 1 ]]; then
        total_noun="actie"
    fi

    # Generate report
    cat > "$report_file" <<EOF
# Lynis Security Actions

**Scan datum:** $scan_date
**Hostname:** $hostname
**Totaal:** $total $total_noun (${severity_counts[CRITICAL]} Critical, ${severity_counts[HIGH]} High)

*Note: Medium en Low severity findings zijn niet opgenomen in dit rapport (focus op urgente items)*

---

EOF

    # Check if there are any CRITICAL/HIGH findings
    if [[ $total -eq 0 ]]; then
        cat >> "$report_file" <<EOF
## ✅ Geen Security Findings

Geen warnings of suggestions gevonden. Systeem is goed geconfigureerd!

---

*Zie compliance report voor overall status*
EOF
        rm -f "$temp_findings"
        echo "✓ Actions report generated: $report_file (no findings)"
        return 0
    fi

    # Generate sections by severity (only CRITICAL and HIGH - Medium/Low excluded for focus)
    for severity in CRITICAL HIGH; do
        local count=${severity_counts[$severity]}
        if [[ $count -eq 0 ]]; then
            continue
        fi

        # Determine icon and deadline
        local icon=""
        local deadline=""
        case $severity in
            CRITICAL)
                icon="🔴"
                deadline="(fix binnen 1 week)"
                ;;
            HIGH)
                icon="🟠"
                deadline="(fix binnen 1 week)"
                ;;
            MEDIUM)
                icon="🟡"
                deadline="(fix binnen 1 maand)"
                ;;
            LOW)
                icon="🟢"
                deadline="(best effort)"
                ;;
        esac

        cat >> "$report_file" <<EOF
## $icon $severity $deadline

EOF

        # Output findings for this severity
        echo "${severity_findings[$severity]}" | while IFS= read -r finding_json; do
            if [[ -z "$finding_json" ]]; then
                continue
            fi

            local test_id=$(echo "$finding_json" | jq -r '.test_id')
            local description=$(echo "$finding_json" | jq -r '.description')

            cat >> "$report_file" <<EOF
### $test_id

$description

EOF
        done

        echo "---" >> "$report_file"
        echo "" >> "$report_file"
    done

    cat >> "$report_file" <<EOF

*Zie compliance report voor overall status*
EOF

    rm -f "$temp_findings"
    echo "✓ Actions report generated: $report_file"
    return 0
}


# ==============================================================================
# ISO27001 XLSX ASSET ROW REPORT GENERATION
# ==============================================================================

# The cell value for a Yes/No column, from a shared check's verdict. The
# detail string is shown beside it and is never inspected to choose the value.
# Usage: _xlsx_verdict_cell <exit_code>
_xlsx_verdict_cell() {
    case "$1" in
        0) echo "Yes" ;;
        1) echo "No" ;;
        *) echo "N.A." ;;
    esac
}

# Render a markdown table whose borders line up, by padding every cell to the
# width of the widest cell in its column.
# Usage: _xlsx_markdown_table <row>...
#   The first row is the header; fields within a row are separated by \x1f.
_xlsx_markdown_table() {
    local -a rows=("$@")
    local -a widths=()
    local -a fields=()
    local row cell dashes out i len rownum=0

    # Widest cell per column
    for row in "${rows[@]}"; do
        IFS=$'\x1f' read -ra fields <<< "$row"
        for i in "${!fields[@]}"; do
            len=${#fields[$i]}
            if [[ -z "${widths[$i]:-}" ]] || (( len > widths[i] )); then
                widths[$i]=$len
            fi
        done
    done

    for row in "${rows[@]}"; do
        IFS=$'\x1f' read -ra fields <<< "$row"
        out="|"
        for i in "${!widths[@]}"; do
            printf -v cell ' %-*s |' "${widths[$i]}" "${fields[$i]:-}"
            out+="$cell"
        done
        printf '%s\n' "$out"

        # Separator directly beneath the header row
        if (( rownum == 0 )); then
            out="|"
            for i in "${!widths[@]}"; do
                printf -v dashes '%*s' $(( widths[i] + 2 )) ''
                out+="${dashes// /-}|"
            done
            printf '%s\n' "$out"
        fi
        rownum=$(( rownum + 1 ))
    done
}

# Generate the ISO27001 asset-register row report.
#
# Maps audit findings onto the columns of the "Active Assets" sheet of
# iso27001-compliance-essential.xlsx. The spreadsheet itself is never read or
# written - this report is input for a human who updates the register by hand.
#
# Render one finding for asset-inventory.json.
#
# A cell value of "N.A." means the audit could not determine it, and a value it
# deliberately declines to assert - vulnerable packages, where the spreadsheet
# contradicts itself about which value means compliant - is passed as the empty
# string. Both serialise as null with the finding text intact, so a consumer can
# tell "not determined, and here is why" from "this generation does not report
# it at all", which an omitted key would not.
#
# A null cell is not the same as a missing measurement. Where the audit
# determined something the sheet has no unambiguous cell for, the determination
# travels as an extra field - vulnerable_packages carries `count` beside its
# null `value` - so refusing to fill in a cell never costs a measurement.
#
# Render one value as the JSON scalar it is: nothing becomes null, a whole
# number becomes a number, anything else a string. Used for the cell and for the
# extras alike, so a count arrives as 1 rather than as "1" - a number inside a
# string is a number the consumer has to parse, and can parse wrongly.
# Usage: _inventory_scalar <raw>
_inventory_scalar() {
    local raw="$1"

    if [[ -z "$raw" ]]; then
        printf 'null'
    elif [[ "$raw" =~ ^(0|-?[1-9][0-9]*)$ ]]; then
        # Canonical integers only. jq reads "007" as 7, so a non-canonical form
        # would be silently reinterpreted rather than carried as written.
        printf '%s' "$raw"
    else
        printf '%s' "$raw" | jq -Rs .
    fi
}

# Usage: _inventory_finding <json_key> <cell> <finding> [extra_key] [extra_value]
_inventory_finding() {
    local key="$1" cell="$2" finding="$3" extra_key="${4:-}" extra_value="${5:-}"
    local value_json

    # "N.A." and "see note" are the spreadsheet's spellings of "no value
    # here", so they are mapped before the general rule rather than inside it.
    if [[ "$cell" == "N.A." || "$cell" == "see note" ]]; then
        cell=""
    fi
    value_json=$(_inventory_scalar "$cell")

    if [[ -n "$extra_key" ]]; then
        jq -nc --argjson value "$value_json" --arg finding "$finding" \
            --arg ek "$extra_key" --argjson ev "$(_inventory_scalar "$extra_value")" \
            '{value: $value, finding: $finding} + {($ek): $ev}'
    else
        jq -nc --argjson value "$value_json" --arg finding "$finding" \
            '{value: $value, finding: $finding}'
    fi
}

# Write asset-inventory.json: the machine-readable counterpart of
# asset-inventory.txt and the xlsx report.
#
# It is emitted from the same determinations the xlsx report renders, rather
# than deriving them again. Whether a disk counts as encrypted or a hardening
# score as compliant is platform-specific knowledge, and a second
# implementation of those rules would drift from this one.
#
# Usage: _write_asset_inventory_json <output_dir> <hostname> <username> \
#            <scan_date> <serial_cell> <model_cell> <findings_json>
_write_asset_inventory_json() {
    local output_dir="$1" hostname="$2" username="$3" scan_date="$4"
    local serial_cell="$5" model_cell="$6" findings="$7"
    local target="$output_dir/asset-inventory.json"

    local serial_json="null"
    if [[ -n "$serial_cell" && "$serial_cell" != "N.A." ]]; then
        serial_json=$(printf '%s' "$serial_cell" | jq -Rs .)
    fi
    local model_json="null"
    if [[ -n "$model_cell" && "$model_cell" != "N.A." ]]; then
        model_json=$(printf '%s' "$model_cell" | jq -Rs .)
    fi

    local platform="linux"
    case "$(uname -s)" in
        Darwin) platform="macos" ;;
        Linux) platform="linux" ;;
    esac

    jq -n \
        --argjson schema_version 2 \
        --arg generated_at "$(date -Iseconds)" \
        --arg honeybadger_version "$(cat "${thisdir:-.}/VERSION-honeybadger" 2>/dev/null || echo unknown)" \
        --arg platform "$platform" \
        --argjson serial "$serial_json" \
        --arg hostname "$hostname" \
        --arg username "$username" \
        --argjson model "$model_json" \
        --arg scan_date "$scan_date" \
        --argjson findings "$findings" \
        '{
            schema_version: $schema_version,
            generated_at: $generated_at,
            honeybadger_version: $honeybadger_version,
            platform: $platform,
            scan_date: $scan_date,
            identity: {
                serial: $serial,
                hostname: $hostname,
                username: $username,
                model: $model
            },
            findings: $findings
        }' > "$target"

    echo "✓ Machine-readable asset inventory: $target"
}

# Recognise the name badgersbay gives an archive it serves for download:
# <asset-ID>-<YYYY-MM-DD>[-<owner slug>].tar[.gz], built from the register by
# evidence_download_name(). That name is what the register's proof_file column
# holds, and the folder the evidence is filed under.
#
# Only the register's asset form is taken. Column M of the sheet reads the
# date from the twelfth character of proof_file, which is right only for a
# ten-character asset ID; any other shape would give M a wrong date.
#
# Sets HB_DOWNLOAD_ASSET and HB_DOWNLOAD_PROOF and returns 0 for a download
# name; clears them and returns 1 for anything else.
# Usage: hb_parse_download_name <archive base name>
hb_parse_download_name() {
    local name="$1"
    HB_DOWNLOAD_ASSET=""
    HB_DOWNLOAD_PROOF=""

    local re='^(TARI-[0-9]{5})-([0-9]{4}-[0-9]{2}-[0-9]{2})(-[a-z0-9.]+)?\.tar(\.gz)?$'
    [[ "$name" =~ $re ]] || return 1

    local asset="${BASH_REMATCH[1]}" day="${BASH_REMATCH[2]}"
    # A calendar date, not merely digits in the right places. GNU date, then BSD.
    if [[ "$(date -d "$day" +%F 2>/dev/null || date -j -f %F "$day" +%F 2>/dev/null)" != "$day" ]]; then
        return 1
    fi

    HB_DOWNLOAD_ASSET="$asset"
    HB_DOWNLOAD_PROOF="${name%.gz}"
    HB_DOWNLOAD_PROOF="${HB_DOWNLOAD_PROOF%.tar}"
    return 0
}

# Usage: generate_xlsx_asset_row_report <output_dir> [archive base name]
# Generates: honeybadger-{user}-{date}-xlsx.md
#
# The archive name is the one check-output was given. When badgersbay named it,
# it carries columns A and N; see hb_parse_download_name.
generate_xlsx_asset_row_report() {
    local output_dir="$1"
    local archive_name="${2:-}"

    if [[ ! -d "$output_dir" ]]; then
        echo "ERROR: Directory $output_dir does not exist" >&2
        return 1
    fi

    local username
    username=$(hb_audit_username "$output_dir") || username=""

    local report_file
    report_file=$(hb_report_basename "$output_dir" xlsx)

    local lynis_file="$output_dir/lynis-report.json"
    local have_lynis=false
    if [[ -f "$lynis_file" ]] && command -v jq >/dev/null 2>&1; then
        # Guard against a truncated or unparseable report
        if jq -e . "$lynis_file" >/dev/null 2>&1; then
            have_lynis=true
        fi
    fi

    # Source files that could not be used, reported at the end
    local -a unavailable=()

    # --- metadata -----------------------------------------------------------
    local hostname="Unknown"
    local scan_date="Unknown"
    local os_cell="N.A."
    local os_src="lynis-report.json not available"

    if [[ "$have_lynis" == true ]]; then
        hostname=$(jq -r '.hostname // "Unknown"' "$lynis_file" 2>/dev/null)
        scan_date=$(jq -r '.report_datetime_start // "Unknown"' "$lynis_file" 2>/dev/null)
        local os_full=$(jq -r '.os_fullname // .os_name // ""' "$lynis_file" 2>/dev/null)
        if [[ -n "$os_full" ]]; then
            os_cell="$os_full"
            os_src="$os_full"
        else
            os_src="os_fullname missing from lynis-report.json"
        fi
    else
        unavailable+=("lynis-report.json - hostname, scan date, OS, hardening score and package data")
    fi

    # --- D: Serial Number ---------------------------------------------------
    local serial_cell="N.A."
    local serial_src="hardware-serial.txt not available"
    local serial_known=false

    if [[ -f "$output_dir/hardware-serial.txt" ]]; then
        if read_recorded_serial "$output_dir"; then
            serial_cell="$HB_SERIAL_VALUE"
            serial_src="$HB_SERIAL_VALUE (source: $HB_SERIAL_SOURCE)"
            serial_known=true
        elif [[ "$HB_SERIAL_STATUS" == "$HB_SERIAL_NOT_PRESENT" ]]; then
            serial_src="none-present - the hardware reports no serial number (common on a VM)"
        else
            serial_src="could-not-read - no source returned a value"
        fi
    else
        unavailable+=("hardware-serial.txt - serial number")
    fi

    # --- C hint + E: Model --------------------------------------------------
    local model_cell="N.A."
    local model_src="fastfetch.json not available"
    # Already the audit's own determination. This used to start from the
    # directory name and be corrected from fastfetch a few lines down;
    # hb_audit_username() reads that same field, so there is one source.
    local scan_user="$username"

    local hw_json="$output_dir/fastfetch.json"
    if [[ -f "$hw_json" ]] && command -v jq >/dev/null 2>&1; then
        local model_raw=$(jq -r '.host // ""' "$hw_json" 2>/dev/null)
        if [[ -n "$model_raw" ]]; then
            model_cell="$model_raw"
            model_src="$model_raw"
        else
            model_src="host missing from $(basename "$hw_json")"
        fi
    else
        unavailable+=("fastfetch.json - model")
    fi

    [[ -z "$scan_user" ]] && scan_user="unknown"

    # --- G, H, I: the shared checks -----------------------------------------
    # Cell value from the verdict, provenance from the detail. A control the
    # check could not establish is listed as unavailable, in the check's words.
    local disk_src disk_verdict disk_cell
    disk_src=$(check_disk_encryption "$output_dir"); disk_verdict=$?
    disk_cell=$(_xlsx_verdict_cell "$disk_verdict")
    (( disk_verdict == 2 )) && unavailable+=("Disk Encryption: $disk_src")

    local lock_src lock_verdict lock_cell
    lock_src=$(check_screen_lock_status "$output_dir"); lock_verdict=$?
    lock_cell=$(_xlsx_verdict_cell "$lock_verdict")
    (( lock_verdict == 2 )) && unavailable+=("Screen Lock: $lock_src")

    local fw_src fw_verdict fw_cell
    fw_src=$(check_firewall_status "$output_dir" 2>/dev/null); fw_verdict=$?
    fw_cell=$(_xlsx_verdict_cell "$fw_verdict")
    (( fw_verdict == 2 )) && unavailable+=("Firewall Active: $fw_src")

    # --- J: Vulnerable Packages / Defender ----------------------------------
    # Deliberately no cell value: the register contradicts itself about which
    # literal means compliant. Report the finding and let the operator choose.
    #
    # The count is a different question, and one the audit can answer. It
    # travels separately so that declining to fill in the cell does not throw
    # away a measurement. Empty means nothing was measured, not zero.
    local vuln_finding vuln_verdict vuln_count_cell=""
    vuln_finding=$(check_vulnerable_packages "$output_dir"); vuln_verdict=$?
    if (( vuln_verdict != 2 )); then
        vuln_count_cell=$(jq -r '.vulnerable_packages_found // ""' "$lynis_file" 2>/dev/null)
    fi

    # --- K: Lynis Hardening Score -------------------------------------------
    local score_cell="N.A."
    local score_src="lynis-report.json not available"
    local min_score
    min_score=$(hb_min_hardening_score)

    if [[ "$have_lynis" == true ]]; then
        local score
        score=$(check_hardening_score "$output_dir")
        if [[ "$score" =~ ^[0-9]+$ ]]; then
            score_cell="$score"
            if (( score >= min_score )); then
                score_src="${score}/100 - threshold >=${min_score} met"
            else
                score_src="${score}/100 - threshold >=${min_score} not met"
            fi
        else
            score_src="hardening_index missing from lynis-report.json"
        fi
    fi

    # --- L: OS Up-to-date ---------------------------------------------------
    # Supported but not the newest release counts as up to date. See
    # check_os_uptodate().
    local uptodate_src uptodate_verdict uptodate_cell
    uptodate_src=$(check_os_uptodate "$output_dir"); uptodate_verdict=$?
    uptodate_cell=$(_xlsx_verdict_cell "$uptodate_verdict")
    (( uptodate_verdict == 2 )) && unavailable+=("OS Up-to-date: $uptodate_src")

    # --- Report -------------------------------------------------------------
    {
        echo "# ISO27001 XLSX - Active Assets"
        echo ""
        echo "**Hostname:** $hostname"
        echo "**Scan date:** $scan_date"
        if [[ "$serial_known" == true ]]; then
            echo "**Find the row by Serial Number:** \`$serial_cell\`"
        else
            echo "**Row cannot be found automatically:** serial number unknown, find the row by hand"
        fi
        echo ""
        echo "This report does not change the spreadsheet. Copy the cell values below by hand"
        echo "into \`iso27001-compliance-essential.xlsx\`, sheet \`Active Assets\`."
        echo ""
        echo "---"
        echo ""
        echo "## Determined by honeybadger"
        echo ""

        # A and N come from the archive name when badgersbay gave it one.
        local -a from_name_first=() from_name_last=()
        local -a by_hand=()
        if [[ -n "$archive_name" ]] && hb_parse_download_name "$archive_name"; then
            from_name_first=("A"$'\x1f'"Asset"$'\x1f'"$HB_DOWNLOAD_ASSET"$'\x1f'"from the archive name ($archive_name)")
            from_name_last=("N"$'\x1f'"proof_file"$'\x1f'"$HB_DOWNLOAD_PROOF"$'\x1f'"the archive name, as badgersbay gave it")
        else
            by_hand+=("A"$'\x1f'"Asset"$'\x1f'"asset ID from the register (e.g. TARI-00023)")
        fi
        by_hand+=("C"$'\x1f'"Owner"$'\x1f'"the register uses full names; scan username: $scan_user")
        if (( ${#from_name_last[@]} == 0 )); then
            by_hand+=("N"$'\x1f'"proof_file"$'\x1f'"convention: <asset-ID>-<YYYY-MM-DD>-<name>")
        fi
        by_hand+=("O"$'\x1f'"Remarks"$'\x1f'"free text field")

        _xlsx_markdown_table \
            "Col"$'\x1f'"Field"$'\x1f'"Cell value"$'\x1f'"Determined as" \
            "${from_name_first[@]}" \
            "D"$'\x1f'"Serial Number"$'\x1f'"$serial_cell"$'\x1f'"$serial_src" \
            "E"$'\x1f'"Model"$'\x1f'"$model_cell"$'\x1f'"$model_src" \
            "F"$'\x1f'"OS Edition + Version"$'\x1f'"$os_cell"$'\x1f'"$os_src" \
            "G"$'\x1f'"Disk Encryption"$'\x1f'"$disk_cell"$'\x1f'"$disk_src" \
            "H"$'\x1f'"Screen Lock"$'\x1f'"$lock_cell"$'\x1f'"$lock_src" \
            "I"$'\x1f'"Firewall Active"$'\x1f'"$fw_cell"$'\x1f'"$fw_src" \
            "J"$'\x1f'"Vulnerable Packages / Defender"$'\x1f'"see note"$'\x1f'"$vuln_finding" \
            "K"$'\x1f'"Lynis Hardening Score"$'\x1f'"$score_cell"$'\x1f'"$score_src" \
            "L"$'\x1f'"OS Up-to-date"$'\x1f'"$uptodate_cell"$'\x1f'"$uptodate_src" \
            "${from_name_last[@]}"

        echo ""
        echo "### Note on column J"
        echo ""
        echo "**Finding:** $vuln_finding"
        echo ""
        echo "Honeybadger deliberately gives no cell value here. The spreadsheet contradicts itself about"
        echo "which value means compliant:"
        echo ""
        echo "- the data validation and the notes on \`Compliance Summary\` say \`None\` = compliant"
        echo "- the \`Status\` formula counts \`Yes\` as good and \`None\` as NOK"
        echo ""
        echo "Choose the value yourself, consistent with the rest of the column."
        echo ""
        echo "---"
        echo ""
        echo "## Maintained by hand"
        echo ""
        echo "Honeybadger cannot determine these columns, so it leaves them empty."
        echo ""

        _xlsx_markdown_table \
            "Col"$'\x1f'"Field"$'\x1f'"Notes" \
            "${by_hand[@]}"

        echo ""
        echo "---"
        echo ""
        echo "## Do not overwrite - formulas"
        echo ""
        echo "These cells hold formulas. Do not type in them, or the calculation is lost."
        echo ""

        _xlsx_markdown_table \
            "Col"$'\x1f'"Field"$'\x1f'"Formula" \
            "B"$'\x1f'"Status"$'\x1f'"array formula over G:J, K and L" \
            "M"$'\x1f'"Last_Audit_Date"$'\x1f'"=MID(N2,12,10) - derived from proof_file"

        if (( ${#unavailable[@]} > 0 )); then
            echo ""
            echo "---"
            echo ""
            echo "## Unavailable source data"
            echo ""
            local missing
            for missing in "${unavailable[@]}"; do
                echo "- $missing"
            done
        fi

        echo ""
        echo "---"
        echo ""
        echo "*See the compliance report for the overall status*"
    } > "$report_file"

    echo "✓ XLSX asset row report generated: $report_file"

    # The same determinations, serialised for the collection server. Emitted
    # here rather than derived again, so the two cannot disagree.
    if command -v jq >/dev/null 2>&1; then
        local findings
        findings=$(jq -nc \
            --argjson os "$(_inventory_finding os "$os_cell" "$os_src")" \
            --argjson disk "$(_inventory_finding disk_encryption "$disk_cell" "$disk_src")" \
            --argjson lock "$(_inventory_finding screen_lock "$lock_cell" "$lock_src")" \
            --argjson fw "$(_inventory_finding firewall "$fw_cell" "$fw_src")" \
            --argjson vuln "$(_inventory_finding vulnerable_packages "" "$vuln_finding" count "$vuln_count_cell")" \
            --argjson score "$(_inventory_finding hardening_score "$score_cell" "$score_src" tool lynis)" \
            --argjson uptodate "$(_inventory_finding os_uptodate "$uptodate_cell" "$uptodate_src")" \
            '{
                os: $os,
                disk_encryption: $disk,
                screen_lock: $lock,
                firewall: $fw,
                vulnerable_packages: $vuln,
                hardening_score: $score,
                os_uptodate: $uptodate
            }')
        _write_asset_inventory_json "$output_dir" "$hostname" "$username" \
            "$scan_date" "$serial_cell" "$model_cell" "$findings"
    else
        echo "WARNING: jq not available - asset-inventory.json not written" >&2
    fi

    return 0
}
