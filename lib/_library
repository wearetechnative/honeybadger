# Analyze kernel status (helper function)
analyze_kernel_status() {
    local report_file="$1"
    local cache_dir="$2"
    local result="unknown"

    # Derive output directory from report file location (report is always $output_dir/os-kernel-status.txt)
    local output_dir
    output_dir=$(dirname "$report_file")

    echo "=====================================" >> "$report_file"
    echo "SECTION 2: KERNEL VERSION STATUS" >> "$report_file"
    echo "=====================================" >> "$report_file"
    echo "" >> "$report_file"
    echo "Detected Kernel: $KERNEL_VERSION" >> "$report_file"
    echo "" >> "$report_file"

    if [[ -z "$KERNEL_VERSION" ]]; then
        echo "Status: UNKNOWN - kernel version not detected" >> "$report_file"
        echo "" >> "$report_file"
        echo "$result"
        return
    fi

    # Extract major.minor series — handles "6.18.37" and "6.8.0-60-generic"
    local kernel_series
    kernel_series=$(echo "$KERNEL_VERSION" | grep -oE '^[0-9]+\.[0-9]+')

    if [[ -z "$kernel_series" ]]; then
        echo "Status: UNKNOWN - unable to parse kernel series" >> "$report_file"
        echo "" >> "$report_file"
        echo "$result"
        return
    fi

    echo "Kernel Series: ${kernel_series}.x" >> "$report_file"

    # Primary data source: fastfetch.json kernel_latest field (populated during collection)
    local kernel_latest_raw="" latest_version="" latest_date="" series_is_eol="false"
    local fastfetch_file="$output_dir/fastfetch.json"

    if [[ -f "$fastfetch_file" ]] && command -v jq >/dev/null 2>&1; then
        kernel_latest_raw=$(jq -r '.kernel_latest // ""' "$fastfetch_file" 2>/dev/null)
    fi

    if [[ -n "$kernel_latest_raw" && "$kernel_latest_raw" != "null" && "$kernel_latest_raw" != "" ]]; then
        # Format: "6.18.38 (2026-07-04)"
        latest_version=$(echo "$kernel_latest_raw" | grep -oE '^[0-9]+\.[0-9]+\.[0-9]+')
        latest_date=$(echo "$kernel_latest_raw" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}')
    else
        # Fallback: kernel-releases.json cache
        if [[ -f "$cache_dir/kernel-releases.json" ]] && command -v jq >/dev/null 2>&1; then
            latest_version=$(jq -r ".releases[] | select(.version | startswith(\"${kernel_series}.\")) | .version" \
                "$cache_dir/kernel-releases.json" 2>/dev/null | head -1)
            latest_date=$(jq -r ".releases[] | select(.version | startswith(\"${kernel_series}.\")) | .released.isodate" \
                "$cache_dir/kernel-releases.json" 2>/dev/null | head -1)
            series_is_eol=$(jq -r ".releases[] | select(.version | startswith(\"${kernel_series}.\")) | .iseol" \
                "$cache_dir/kernel-releases.json" 2>/dev/null | head -1)
            series_is_eol="${series_is_eol:-false}"
        fi

        # EOL check takes priority — iseol:true can coexist with a version entry
        if [[ "$series_is_eol" == "true" ]]; then
            echo "Type: EOL (upstream End-of-Life)" >> "$report_file"
            echo "" >> "$report_file"
            echo "1. EOL STATUS" >> "$report_file"
            echo "-------------" >> "$report_file"
            echo "Status: ✗ END OF LIFE" >> "$report_file"
            echo "  The ${kernel_series}.x series is no longer maintained upstream." >> "$report_file"
            echo "  No further security patches will be released." >> "$report_file"
            echo "" >> "$report_file"
            echo "fail"
            return
        fi

        if [[ -z "$latest_version" || "$latest_version" == "null" ]]; then
            echo "Status: UNKNOWN - kernel series ${kernel_series}.x not found in available data" >> "$report_file"
            echo "" >> "$report_file"
            echo "$result"
            return
        fi
    fi

    # Determine kernel type from cache if available
    local moniker=""
    if [[ -f "$cache_dir/kernel-releases.json" ]] && command -v jq >/dev/null 2>&1; then
        moniker=$(jq -r ".releases[] | select(.version | startswith(\"${kernel_series}.\")) | .moniker" \
            "$cache_dir/kernel-releases.json" 2>/dev/null | head -1)
    fi

    local type_label
    case "$moniker" in
        mainline)   type_label="Mainline (short-lived, ~3 months support)" ;;
        stable)     type_label="Stable" ;;
        longterm)   type_label="Long-Term Support (LTS)" ;;
        linux-next) type_label="linux-next (development only)" ;;
        *)          type_label="${moniker:-Unknown}" ;;
    esac

    echo "Type: $type_label" >> "$report_file"
    [[ -n "$latest_version" ]] && echo "Latest in series: $latest_version${latest_date:+ (released: $latest_date)}" >> "$report_file"
    echo "" >> "$report_file"

    # 1. EOL status
    echo "1. EOL STATUS" >> "$report_file"
    echo "-------------" >> "$report_file"
    echo "Status: ✓ SUPPORTED - ${kernel_series}.x receives security patches" >> "$report_file"
    echo "" >> "$report_file"
    result="pass"

    # 2. Patch currency — distro-aware
    local running_upstream
    running_upstream=$(echo "$KERNEL_VERSION" | grep -oE '^[0-9]+\.[0-9]+\.[0-9]+')

    echo "2. PATCH CURRENCY" >> "$report_file"
    echo "-----------------" >> "$report_file"

    if [[ -z "$running_upstream" || -z "$latest_version" ]]; then
        echo "Status: UNABLE TO DETERMINE" >> "$report_file"
    elif [[ "$running_upstream" == "$latest_version" ]]; then
        echo "Status: ✓ UP TO DATE - running latest patch ($latest_version)" >> "$report_file"
    else
        case "$OS_NAME" in
            NixOS|Arch|"Arch Linux")
                echo "Status: ⚠ PATCH AVAILABLE" >> "$report_file"
                echo "  Running: $running_upstream" >> "$report_file"
                echo "  Latest:  $latest_version${latest_date:+ (released: $latest_date)}" >> "$report_file"
                result="warning"
                ;;
            Ubuntu)
                echo "Status: ℹ INFO - upstream patch available (Ubuntu maintains own kernel numbering)" >> "$report_file"
                echo "  Running: $running_upstream" >> "$report_file"
                echo "  Upstream latest: $latest_version${latest_date:+ (released: $latest_date)}" >> "$report_file"
                echo "  Ubuntu may continue to support this kernel; verify via Ubuntu security advisories." >> "$report_file"
                ;;
            Debian)
                echo "Status: ℹ INFO - upstream patch available (Debian maintains own kernel patch numbering)" >> "$report_file"
                echo "  Running: $running_upstream" >> "$report_file"
                echo "  Upstream latest: $latest_version${latest_date:+ (released: $latest_date)}" >> "$report_file"
                ;;
            *)
                echo "Status: ⚠ PATCH AVAILABLE" >> "$report_file"
                echo "  Running: $running_upstream" >> "$report_file"
                echo "  Latest:  $latest_version${latest_date:+ (released: $latest_date)}" >> "$report_file"
                result="warning"
                ;;
        esac
    fi
    echo "" >> "$report_file"

    echo "$result"
}

# Generate status summary (helper function)
# Usage: generate_status_summary <report_file> <os_status> <kernel_status> <cache_dir>
generate_status_summary() {
    local report_file="$1"
    local os_status="$2"
    local kernel_status="$3"
    local cache_dir="$4"

    # Worst-of logic: fail > warning > pass; unknown does not degrade os_status
    local combined_status="$os_status"
    if [[ "$os_status" == "fail" || "$kernel_status" == "fail" ]]; then
        combined_status="fail"
    elif [[ "$os_status" == "warning" || "$kernel_status" == "warning" ]]; then
        combined_status="warning"
    elif [[ "$os_status" == "pass" && "$kernel_status" == "pass" ]]; then
        combined_status="pass"
    fi

    echo "" >> "$report_file"
    echo "=====================================" >> "$report_file"
    echo "OVERALL SYSTEM STATUS" >> "$report_file"
    echo "=====================================" >> "$report_file"
    echo "" >> "$report_file"

    case "$combined_status" in
        pass)
            echo "Result: ✓ PASS" >> "$report_file"
            echo "" >> "$report_file"
            echo "Your system is running a supported operating system version" >> "$report_file"
            echo "with an active update stream. No immediate action required." >> "$report_file"
            echo "" >> "$report_file"
            echo "Recommendations:" >> "$report_file"
            echo "  - Continue applying regular system updates" >> "$report_file"
            echo "  - Monitor for new releases and security updates" >> "$report_file"
            echo "  - Review this report periodically (at least quarterly)" >> "$report_file"
            ;;
        warning)
            echo "Result: ⚠ WARNING" >> "$report_file"
            echo "" >> "$report_file"
            echo "Your system is NOT running the latest version but STILL RECEIVES UPDATES." >> "$report_file"
            echo "An upgrade is recommended but not critical." >> "$report_file"
            echo "" >> "$report_file"
            echo "Recommendations:" >> "$report_file"
            echo "  - Plan an upgrade to the latest stable release" >> "$report_file"
            echo "  - Continue applying security updates in the meantime" >> "$report_file"
            echo "  - Review the upgrade path and test in a staging environment" >> "$report_file"

            # OS-specific upgrade recommendation — only when OS itself is outdated
            if [[ "$os_status" == "warning" ]]; then
                local latest_release=""
                case "$OS_NAME" in
                    NixOS)
                        latest_release=$(get_latest_nixos_release "$cache_dir")
                        [[ -n "$latest_release" ]] && echo "  - Target OS version: NixOS $latest_release" >> "$report_file"
                        ;;
                    Ubuntu)
                        latest_release=$(get_latest_ubuntu_lts "$cache_dir")
                        [[ -n "$latest_release" ]] && echo "  - Target OS version: Ubuntu $latest_release LTS" >> "$report_file"
                        ;;
                esac
            fi

            # Kernel-specific recommendation when kernel triggered the warning
            if [[ "$kernel_status" == "warning" ]]; then
                echo "  - Apply kernel updates via regular system updates (e.g. nixos-rebuild switch --upgrade, apt upgrade)" >> "$report_file"
            fi
            ;;
        fail)
            echo "Result: ✗ FAIL" >> "$report_file"
            echo "" >> "$report_file"
            echo "CRITICAL: Your system NO LONGER RECEIVES UPDATES (End-of-Life)." >> "$report_file"
            echo "This version has reached EOL and no longer receives security updates." >> "$report_file"
            echo "This poses a significant security risk." >> "$report_file"
            echo "" >> "$report_file"
            echo "URGENT Actions Required:" >> "$report_file"
            echo "  1. DO NOT connect this system to untrusted networks" >> "$report_file"
            echo "  2. Plan an immediate upgrade to a supported version" >> "$report_file"
            echo "  3. If upgrade is not immediately possible:" >> "$report_file"
            echo "     - Isolate the system from the internet" >> "$report_file"
            echo "     - Restrict network access to essential services only" >> "$report_file"
            echo "     - Increase monitoring and auditing" >> "$report_file"
            echo "  4. Document the security risk and create an upgrade timeline" >> "$report_file"

            # OS-specific upgrade recommendation
            local latest_release=""
            case "$OS_NAME" in
                NixOS)
                    latest_release=$(get_latest_nixos_release "$cache_dir")
                    [[ -n "$latest_release" ]] && echo "  5. Upgrade OS to: NixOS $latest_release" >> "$report_file"
                    ;;
                Ubuntu)
                    latest_release=$(get_latest_ubuntu_lts "$cache_dir")
                    [[ -n "$latest_release" ]] && echo "  5. Upgrade OS to: Ubuntu $latest_release LTS" >> "$report_file"
                    ;;
            esac

            # Kernel-specific recommendation when kernel triggered the fail
            if [[ "$kernel_status" == "fail" ]]; then
                echo "  - KERNEL EOL: upgrade to a supported kernel series immediately" >> "$report_file"
                echo "    Check https://www.kernel.org for supported series" >> "$report_file"
            fi

            echo "" >> "$report_file"
            echo "ISO27001 Compliance Note:" >> "$report_file"
            echo "Running EOL software may violate security policies and compliance" >> "$report_file"
            echo "requirements. Document this finding and escalate appropriately." >> "$report_file"
            ;;
        *)
            echo "Result: ? UNKNOWN" >> "$report_file"
            echo "" >> "$report_file"
            echo "Unable to determine system status. This may be due to:" >> "$report_file"
            echo "  - Unsupported or unrecognized operating system" >> "$report_file"
            echo "  - Missing or incomplete system information" >> "$report_file"
            echo "  - Unable to fetch release data from external sources" >> "$report_file"
            echo "" >> "$report_file"
            echo "Recommendations:" >> "$report_file"
            echo "  - Verify system information is correctly reported" >> "$report_file"
            echo "  - Check internet connectivity for release data updates" >> "$report_file"
            echo "  - Manually verify OS version support status" >> "$report_file"
            echo "  - Consult your OS vendor's support lifecycle documentation" >> "$report_file"
            ;;
    esac

    echo "" >> "$report_file"
    echo "=====================================" >> "$report_file"
    echo "END OF REPORT" >> "$report_file"
    echo "=====================================" >> "$report_file"
}

# ==============================================================================
# HARDWARE SERIAL COLLECTION
# ==============================================================================
#
# The hardware serial is the key the collection server matches a submission to
# an asset on, so the audit reads it from the kernel first and only falls back
# to external tools. Every platform runs the same usability check before a
# value is written, because a value the server rejects helps nobody and a
# fragment of unrelated output is worse than nothing: it looks like data.
#
# Results are returned through three globals, set by collect_hardware_serial():
#
#   HB_SERIAL_VALUE    the serial, empty unless HB_SERIAL_STATUS is "ok"
#   HB_SERIAL_SOURCE   which source produced it, or which failed last
#   HB_SERIAL_STATUS   ok | none-present | could-not-read

# Values firmware reports in place of a real serial. Kept identical to the list
# the collection server applies when matching, compared case-insensitively.
HB_SERIAL_PLACEHOLDERS=(
    "not available"
    "not available (vm or unknown hardware)"
    "to be filled by o.e.m."
    "to be filled"
    "default string"
    "not specified"
    "system serial number"
    "none"
    "unknown"
)

# The two tokens written when no usable serial could be determined.
HB_SERIAL_NOT_READ="could-not-read"
HB_SERIAL_NOT_PRESENT="none-present"

# Decide whether a value is a usable hardware serial.
# A usable serial is one token: non-empty, free of whitespace and control
# characters, not a known placeholder and not all zeroes.
# Usage: is_usable_serial <value>
# Returns: 0 when usable, 1 otherwise
is_usable_serial() {
    local value="$1"

    [[ -z "$value" ]] && return 1
    # A serial is a single token. "Mac OS X<TAB>" fails here, as it should.
    [[ "$value" =~ [[:space:]] ]] && return 1
    [[ "$value" =~ [[:cntrl:]] ]] && return 1
    # All zeroes, at any length, is a firmware default rather than a measurement
    [[ "$value" =~ ^0+$ ]] && return 1
    # So are the two tokens this tool itself writes when there is no serial
    [[ "$value" == "$HB_SERIAL_NOT_READ" || "$value" == "$HB_SERIAL_NOT_PRESENT" ]] && return 1

    local lower placeholder
    lower=$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')
    for placeholder in "${HB_SERIAL_PLACEHOLDERS[@]}"; do
        [[ "$lower" == "$placeholder" ]] && return 1
    done

    return 0
}

# Strip line endings from a raw source value. Any remaining whitespace is left
# in place so is_usable_serial() can reject it.
# Usage: _hb_serial_clean <value>
_hb_serial_clean() {
    printf '%s' "$1" | tr -d '\r\n'
}

# Extract IOPlatformSerialNumber from `ioreg -d2 -c IOPlatformExpertDevice`.
# Reads the ioreg output on stdin so it can be tested against captured output.
hb_parse_ioreg_serial() {
    awk -F'"' '/IOPlatformSerialNumber/ { print $(NF-1); exit }'
}

# Extract the serial from `system_profiler SPHardwareDataType`.
# Reads the system_profiler output on stdin. Restricting the caller to
# SPHardwareDataType keeps this to the one "Serial Number" line that matters.
hb_parse_system_profiler_serial() {
    awk '/Serial Number/ { sub(/^[^:]*:[[:space:]]*/, ""); print; exit }'
}

# Determine whether this machine runs NixOS, for the nix fallback only.
# is_nixos() answers the same question about an audit output directory; this
# one asks about the running system.
hb_running_on_nixos() {
    local os_release="${HB_OS_RELEASE_FILE:-/etc/os-release}"

    [[ -f "$os_release" ]] && grep -q '^ID=nixos' "$os_release" 2>/dev/null && return 0
    command -v nixos-version >/dev/null 2>&1 && return 0
    return 1
}

# Linux serial chain. Each source is tried only when the previous produced
# nothing usable, so a machine with working sysfs never pays for the rest.
#
#   1. /sys/class/dmi/id/product_serial   root, no tool, no network
#   2. /sys/class/dmi/id/board_serial     some vendors fill only this one
#   3. dmidecode -s system-serial-number  when the tool happens to be present
#   4. nix run nixpkgs#dmidecode          NixOS last resort, needs the network
#
# Sets HB_SERIAL_VALUE / HB_SERIAL_SOURCE / HB_SERIAL_STATUS.
hb_collect_serial_linux() {
    local product_serial="${HB_SYSFS_PRODUCT_SERIAL:-/sys/class/dmi/id/product_serial}"
    local board_serial="${HB_SYSFS_BOARD_SERIAL:-/sys/class/dmi/id/board_serial}"
    # Whether any source answered at all. A source that answered with an empty
    # or placeholder value means the hardware has no serial; a source that
    # could not be consulted at all means we failed to read one.
    local responded=0
    local raw=""

    if [[ -r "$product_serial" ]]; then
        responded=1
        raw=$(_hb_serial_clean "$(cat "$product_serial" 2>/dev/null)")
        if is_usable_serial "$raw"; then
            HB_SERIAL_VALUE="$raw"
            HB_SERIAL_SOURCE="sysfs:product_serial"
            HB_SERIAL_STATUS="ok"
            return 0
        fi
    fi

    if [[ -r "$board_serial" ]]; then
        responded=1
        raw=$(_hb_serial_clean "$(cat "$board_serial" 2>/dev/null)")
        if is_usable_serial "$raw"; then
            HB_SERIAL_VALUE="$raw"
            HB_SERIAL_SOURCE="sysfs:board_serial"
            HB_SERIAL_STATUS="ok"
            return 0
        fi
    fi

    if command -v dmidecode >/dev/null 2>&1; then
        if raw=$(dmidecode -s system-serial-number 2>/dev/null); then
            responded=1
            raw=$(_hb_serial_clean "$raw")
            if is_usable_serial "$raw"; then
                HB_SERIAL_VALUE="$raw"
                HB_SERIAL_SOURCE="dmidecode"
                HB_SERIAL_STATUS="ok"
                return 0
            fi
        fi
    fi

    # Last resort, and only on NixOS: fetching dmidecode needs flakes enabled
    # and the network on first use. With sysfs first it should never be reached.
    if hb_running_on_nixos && command -v nix >/dev/null 2>&1; then
        if raw=$(nix run nixpkgs#dmidecode \
                     --extra-experimental-features "nix-command flakes" \
                     -- -s system-serial-number 2>/dev/null); then
            responded=1
            raw=$(_hb_serial_clean "$raw")
            if is_usable_serial "$raw"; then
                HB_SERIAL_VALUE="$raw"
                HB_SERIAL_SOURCE="nix:dmidecode"
                HB_SERIAL_STATUS="ok"
                return 0
            fi
        fi
    fi

    if [[ $responded -eq 1 ]]; then
        HB_SERIAL_STATUS="$HB_SERIAL_NOT_PRESENT"
        HB_SERIAL_SOURCE="hardware-reports-none"
    else
        HB_SERIAL_STATUS="$HB_SERIAL_NOT_READ"
        HB_SERIAL_SOURCE="no-source-available"
    fi
    return 1
}

# macOS serial. The platform serial is a property, so read it as one rather
# than parsing a human-readable report whose labels change between releases.
# Sets HB_SERIAL_VALUE / HB_SERIAL_SOURCE / HB_SERIAL_STATUS.
hb_collect_serial_macos() {
    local responded=0
    local raw=""

    # Capture first and parse afterwards: piping straight into the parser would
    # hand back the parser's exit status, and a tool that failed outright would
    # then be counted as having answered.
    local tool_output=""

    if command -v ioreg >/dev/null 2>&1; then
        if tool_output=$(ioreg -d2 -c IOPlatformExpertDevice 2>/dev/null); then
            responded=1
            raw=$(_hb_serial_clean "$(printf '%s\n' "$tool_output" | hb_parse_ioreg_serial)")
            if is_usable_serial "$raw"; then
                HB_SERIAL_VALUE="$raw"
                HB_SERIAL_SOURCE="ioreg:IOPlatformSerialNumber"
                HB_SERIAL_STATUS="ok"
                return 0
            fi
        fi
    fi

    if command -v system_profiler >/dev/null 2>&1; then
        if tool_output=$(system_profiler SPHardwareDataType 2>/dev/null); then
            responded=1
            raw=$(_hb_serial_clean "$(printf '%s\n' "$tool_output" | hb_parse_system_profiler_serial)")
            if is_usable_serial "$raw"; then
                HB_SERIAL_VALUE="$raw"
                HB_SERIAL_SOURCE="system_profiler:SPHardwareDataType"
                HB_SERIAL_STATUS="ok"
                return 0
            fi
        fi
    fi

    if [[ $responded -eq 1 ]]; then
        HB_SERIAL_STATUS="$HB_SERIAL_NOT_PRESENT"
        HB_SERIAL_SOURCE="hardware-reports-none"
    else
        HB_SERIAL_STATUS="$HB_SERIAL_NOT_READ"
        HB_SERIAL_SOURCE="no-source-available"
    fi
    return 1
}

# Collect the hardware serial and write it to the output directory.
# Writes hardware-serial.txt (the serial, or one of the two not-found tokens)
# and hardware-serial-source.txt (which source produced it).
# Usage: collect_hardware_serial <output_dir>
# Returns: 0 when a usable serial was written, 1 otherwise
collect_hardware_serial() {
    local output_dir="$1"

    HB_SERIAL_VALUE=""
    HB_SERIAL_SOURCE=""
    HB_SERIAL_STATUS="$HB_SERIAL_NOT_READ"

    local platform="${HB_SERIAL_PLATFORM:-}"
    if [[ -z "$platform" ]]; then
        case "$(uname -s 2>/dev/null)" in
            Darwin) platform="macos" ;;
            Linux)  platform="linux" ;;
            *)      platform="unknown" ;;
        esac
    fi

    case "$platform" in
        linux) hb_collect_serial_linux ;;
        macos) hb_collect_serial_macos ;;
        *)
            HB_SERIAL_STATUS="$HB_SERIAL_NOT_READ"
            HB_SERIAL_SOURCE="unsupported-platform"
            ;;
    esac

    if [[ -n "$output_dir" && -d "$output_dir" ]]; then
        if [[ "$HB_SERIAL_STATUS" == "ok" ]]; then
            printf '%s\n' "$HB_SERIAL_VALUE" > "$output_dir/hardware-serial.txt"
        else
            printf '%s\n' "$HB_SERIAL_STATUS" > "$output_dir/hardware-serial.txt"
        fi
        printf '%s\n' "${HB_SERIAL_SOURCE:-unknown}" > "$output_dir/hardware-serial-source.txt"
    fi

    [[ "$HB_SERIAL_STATUS" == "ok" ]]
}

# One line for the operator, naming which of the two outcomes applies.
# Usage: hb_serial_report_line
hb_serial_report_line() {
    case "$HB_SERIAL_STATUS" in
        ok)
            echo "  ✅ Hardware serial: $HB_SERIAL_VALUE (source: $HB_SERIAL_SOURCE)"
            ;;
        "$HB_SERIAL_NOT_PRESENT")
            echo "  ⚠️  Hardware serial: none-present - the hardware reports no serial."
            echo "      Common on virtual machines. This asset needs a different key"
            echo "      in the register rather than a repair."
            ;;
        *)
            echo "  ❌ Hardware serial: could-not-read - no source returned a value."
            echo "      Checked /sys/class/dmi/id/product_serial, board_serial,"
            echo "      dmidecode and (on NixOS) nix run nixpkgs#dmidecode."
            echo "      The submission will be stored but stays unmatched."
            ;;
    esac
}

# Read the serial recorded in an output directory, for the report generators.
# Sets HB_SERIAL_VALUE / HB_SERIAL_SOURCE / HB_SERIAL_STATUS from the files.
# Archives written before this chain existed hold values such as "Not available"
# or a fragment of unrelated output; those become could-not-read, because at
# this distance there is no telling which of the two outcomes applied.
# Usage: read_recorded_serial <output_dir>
# Returns: 0 when a usable serial was recorded, 1 otherwise
read_recorded_serial() {
    local output_dir="$1"
    local raw=""

    HB_SERIAL_VALUE=""
    HB_SERIAL_SOURCE="unknown"
    HB_SERIAL_STATUS="$HB_SERIAL_NOT_READ"

    if [[ -f "$output_dir/hardware-serial-source.txt" ]]; then
        raw=$(_hb_serial_clean "$(cat "$output_dir/hardware-serial-source.txt" 2>/dev/null)")
        [[ -n "$raw" ]] && HB_SERIAL_SOURCE="$raw"
    fi

    if [[ ! -f "$output_dir/hardware-serial.txt" ]]; then
        return 1
    fi

    raw=$(_hb_serial_clean "$(cat "$output_dir/hardware-serial.txt" 2>/dev/null)")

    if is_usable_serial "$raw"; then
        HB_SERIAL_VALUE="$raw"
        HB_SERIAL_STATUS="ok"
        return 0
    fi

    if [[ "$raw" == "$HB_SERIAL_NOT_PRESENT" ]]; then
        HB_SERIAL_STATUS="$HB_SERIAL_NOT_PRESENT"
    else
        HB_SERIAL_STATUS="$HB_SERIAL_NOT_READ"
    fi
    return 1
}

# ==============================================================================
# ASSET INVENTORY FUNCTIONS
# ==============================================================================

# Generate asset inventory table from available data
# Usage: generate_asset_inventory <output_dir>
generate_asset_inventory() {
    local output_dir="$1"
    local report_file="$output_dir/asset-inventory.txt"

    if [[ ! -d "$output_dir" ]]; then
        echo "ERROR: Directory $output_dir does not exist"
        return 1
    fi

    # Extract data from available files
    local hostname=""
    local os_full=""
    local os_version=""
    local kernel=""
    local model=""
    local serial=""
    local disk_encrypted="Unknown"
    local screen_lock="Unknown"
    local nix_installed="Unknown"
    local malware_scanner="Unknown"
    local firewall_active="Unknown"
    local os_uptodate="Unknown"
    local owner=""
    local report_date=""
    local hardening_score=""
    local hardening_status=""
    local nixos_commit=""
    local nixos_generation=""

    # Minimum hardening score threshold for compliance
    local MIN_HARDENING_SCORE=65

    # Get hostname and OS info from lynis-report.json
    if [[ -f "$output_dir/lynis-report.json" ]] && command -v jq >/dev/null 2>&1; then
        hostname=$(jq -r '.hostname // "Unknown"' "$output_dir/lynis-report.json" 2>/dev/null)
        os_full=$(jq -r '.os_fullname // .os_name // "Unknown"' "$output_dir/lynis-report.json" 2>/dev/null)
        os_version=$(jq -r '.os_version // "Unknown"' "$output_dir/lynis-report.json" 2>/dev/null)
        malware_scanner=$(jq -r '.malware_scanner_installed // "0"' "$output_dir/lynis-report.json" 2>/dev/null)
        [[ "$malware_scanner" == "1" ]] && malware_scanner="Yes" || malware_scanner="No"

        # Use check_firewall_status() for enhanced detection with fallback
        firewall_active=$(check_firewall_status "$output_dir")

        # Extract hardening score
        hardening_score=$(jq -r '.hardening_index // "Unknown"' "$output_dir/lynis-report.json" 2>/dev/null)

        # Format hardening score with status indicator and compliance check
        if [[ "$hardening_score" != "Unknown" && "$hardening_score" =~ ^[0-9]+$ ]]; then
            # Determine status indicator based on score
            if [[ $hardening_score -ge 80 ]]; then
                hardening_status="Excellent"
            elif [[ $hardening_score -ge 60 ]]; then
                hardening_status="Good"
            elif [[ $hardening_score -ge 40 ]]; then
                hardening_status="Fair"
            else
                hardening_status="Poor"
            fi

            # Check compliance threshold
            if [[ $hardening_score -ge $MIN_HARDENING_SCORE ]]; then
                hardening_score="${hardening_score}/100 ($hardening_status) ✅ COMPLIANT (≥${MIN_HARDENING_SCORE})"
            else
                hardening_score="${hardening_score}/100 ($hardening_status) ❌ NON-COMPLIANT (required: ≥${MIN_HARDENING_SCORE})"
            fi
        else
            hardening_score="Unknown"
        fi
    fi

    # Read the serial the audit recorded, along with the source it came from.
    # read_recorded_serial() applies the same usability rule the collection
    # server does, so an unusable value never reaches the table as though it
    # were a measurement.
    read_recorded_serial "$output_dir" || true
    local serial_source="$HB_SERIAL_SOURCE"
    if [[ "$HB_SERIAL_STATUS" == "ok" ]]; then
        serial="$HB_SERIAL_VALUE"
    else
        serial="$HB_SERIAL_STATUS"
    fi

    # Get hardware info from fastfetch.json, neofetch.json or neofetch.txt
    local _hw_json=""
    if [[ -f "$output_dir/fastfetch.json" ]]; then
        _hw_json="$output_dir/fastfetch.json"
    elif [[ -f "$output_dir/neofetch.json" ]]; then
        _hw_json="$output_dir/neofetch.json"
    fi

    if [[ -n "$_hw_json" ]]; then
        # Extract from JSON
        owner=$(jq -r '.user // empty' "$_hw_json" 2>/dev/null)
        model=$(jq -r '.host // empty' "$_hw_json" 2>/dev/null)
        kernel=$(jq -r '.kernel // empty' "$_hw_json" 2>/dev/null)

        # If hostname not found in lynis, get from JSON
        if [[ "$hostname" == "Unknown" ]]; then
            local json_hostname=$(jq -r '.hostname // empty' "$_hw_json" 2>/dev/null)
            [[ -n "$json_hostname" ]] && hostname="$json_hostname"
        fi
    elif [[ -f "$output_dir/neofetch.txt" ]]; then
        # Fallback to text parsing for backward compatibility
        owner=$(grep "^[a-z]*@" "$output_dir/neofetch.txt" | cut -d'@' -f1 | head -1)
        model=$(grep "^Host:" "$output_dir/neofetch.txt" | sed 's/^Host: //' | head -1)
        kernel=$(grep "^Kernel:" "$output_dir/neofetch.txt" | sed 's/^Kernel: //' | head -1)

        if [[ "$hostname" == "Unknown" ]]; then
            hostname=$(grep "^[a-z]*@" "$output_dir/neofetch.txt" | cut -d'@' -f2 | awk '{print $1}' | head -1)
        fi
    fi

    # Check for disk encryption from blockdevices.txt
    if [[ -f "$output_dir/blockdevices.txt" ]]; then
        if grep -q "crypto_LUKS" "$output_dir/blockdevices.txt"; then
            disk_encrypted="Yes (LUKS)"
        else
            disk_encrypted="No"
        fi
    fi

    # Check screen lock from screenlock-info.txt
    if [[ -f "$output_dir/screenlock-info.txt" ]]; then
        if grep -q "AUTO-LOCK-STATUS: ENABLED" "$output_dir/screenlock-info.txt"; then
            screen_lock="Yes (Auto-lock enabled)"
            # Extract the human-readable part (e.g., "10 minutes")
            local lock_time=$(grep "Total time until auto-lock:" "$output_dir/screenlock-info.txt" | grep -oP '\([0-9]+ [a-z]+\)' | tr -d '()')
            [[ -n "$lock_time" ]] && screen_lock="Yes (Auto-lock: $lock_time)"
        else
            screen_lock="Not detected / Disabled"
        fi
    fi

    # Check for Nix installation
    if [[ "$os_full" =~ "NixOS" ]]; then
        nix_installed="Yes (NixOS)"
    elif [[ -f "$output_dir/fastfetch.json" ]] || [[ -f "$output_dir/neofetch.json" ]]; then
        # Check JSON for nix packages (prefer fastfetch.json)
        local _nix_json=""
        [[ -f "$output_dir/fastfetch.json" ]] && _nix_json="$output_dir/fastfetch.json" || _nix_json="$output_dir/neofetch.json"
        local packages=$(jq -r '.packages // empty' "$_nix_json" 2>/dev/null)
        if [[ -n "$packages" ]] && echo "$packages" | grep -q "nix-"; then
            nix_installed="Yes"
        fi
    elif [[ -f "$output_dir/neofetch.txt" ]] && grep -q "nix-" "$output_dir/neofetch.txt"; then
        nix_installed="Yes"
    elif [[ -f "$output_dir/installed-packages.txt" ]] && grep -qi "nix" "$output_dir/installed-packages.txt"; then
        nix_installed="Yes"
    else
        nix_installed="No"
    fi

    # Check OS up-to-date status from os-kernel-status.txt
    if [[ -f "$output_dir/os-kernel-status.txt" ]]; then
        if grep -q "Result: ✓ PASS" "$output_dir/os-kernel-status.txt"; then
            os_uptodate="Yes (Current)"
        elif grep -q "Result: ⚠ WARNING" "$output_dir/os-kernel-status.txt"; then
            os_uptodate="Supported (Upgrade recommended)"
        elif grep -q "Result: ✗ FAIL" "$output_dir/os-kernel-status.txt"; then
            os_uptodate="No (EOL)"
        else
            os_uptodate="Unknown"
        fi
    fi

    # Get report date from directory name or file timestamp
    if [[ "$output_dir" =~ ([0-9]{2}-[0-9]{2}-[0-9]{4}) ]]; then
        report_date="${BASH_REMATCH[1]}"
    elif [[ -f "$output_dir/lynis-report.json" ]]; then
        report_date=$(date -r "$output_dir/lynis-report.json" +"%d-%m-%Y" 2>/dev/null)
    fi

    # Extract NixOS metadata if available
    if [[ -f "$output_dir/nixos-system-info.txt" ]]; then
        # Try to extract commit hash from nixos-version output or JSON
        local version_line=$(grep -E "^[0-9]+\.[0-9]+\." "$output_dir/nixos-system-info.txt" | head -1)
        if [[ -n "$version_line" && "$version_line" =~ \.([a-f0-9]{7,}) ]]; then
            nixos_commit="${BASH_REMATCH[1]}"
        else
            # Try to extract from parentheses using sed as fallback
            local paren_content=$(echo "$version_line" | sed -n 's/.*(\([^)]*\)).*/\1/p')
            if [[ -n "$paren_content" ]]; then
                nixos_commit="${paren_content:0:8}"
            fi
        fi

        # Extract generation number from system path
        local gen_line=$(grep "system-.*-link" "$output_dir/nixos-system-info.txt" | head -1)
        if [[ "$gen_line" =~ system-([0-9]+)-link ]]; then
            nixos_generation="${BASH_REMATCH[1]}"
        fi
    fi

    # Generate report
    echo "=====================================" > "$report_file"
    echo "  ASSET INVENTORY" >> "$report_file"
    echo "=====================================" >> "$report_file"
    echo "" >> "$report_file"
    echo "This table contains asset information extracted from the audit report." >> "$report_file"
    echo "" >> "$report_file"

    # Create table
    printf "%-35s | %s\n" "Field" "Value" >> "$report_file"
    printf "%-35s-+-" "-----------------------------------" >> "$report_file"
    printf "%s\n" "----------------------------------------" >> "$report_file"
    printf "%-35s | %s\n" "Hostname (Asset ID)" "$hostname" >> "$report_file"
    printf "%-35s | %s\n" "Serial Number" "$serial" >> "$report_file"
    printf "%-35s | %s\n" "Serial Source" "$serial_source" >> "$report_file"
    printf "%-35s | %s\n" "Model" "$model" >> "$report_file"
    printf "%-35s | %s\n" "Description" "Personal Device" >> "$report_file"
    printf "%-35s | %s\n" "OS Edition + Version" "$os_full" >> "$report_file"
    printf "%-35s | %s\n" "Kernel Version" "$kernel" >> "$report_file"
    printf "%-35s | %s\n" "Nix Installed" "$nix_installed" >> "$report_file"
    printf "%-35s | %s\n" "Disk Encryption" "$disk_encrypted" >> "$report_file"
    printf "%-35s | %s\n" "Screen Lock" "$screen_lock" >> "$report_file"
    printf "%-35s | %s\n" "Malware Scanner" "$malware_scanner" >> "$report_file"
    printf "%-35s | %s\n" "Firewall Active" "$firewall_active" >> "$report_file"
    printf "%-35s | %s\n" "OS Up-to-date" "$os_uptodate" >> "$report_file"
    printf "%-35s | %s\n" "Lynis Hardening Score" "$hardening_score" >> "$report_file"
    # Add NixOS-specific fields if available
    if [[ -n "$nixos_commit" ]]; then
        printf "%-35s | %s\n" "NixOS Commit Hash" "$nixos_commit" >> "$report_file"
    fi
    if [[ -n "$nixos_generation" ]]; then
        printf "%-35s | %s\n" "NixOS Generation" "$nixos_generation" >> "$report_file"
    fi
    # Add NixOS supply chain field if NixOS
    if is_nixos "$output_dir"; then
        local supply_chain_result=$(check_nixos_supply_chain "$output_dir")
        local supply_chain_display="Unknown"
        if [[ "$supply_chain_result" == "PASS" ]]; then
            supply_chain_display="Secure (sigs enforced)"
        elif [[ "$supply_chain_result" == "FAIL" ]]; then
            supply_chain_display="Insecure"
        fi
        printf "%-35s | %s\n" "NixOS Supply Chain" "$supply_chain_display" >> "$report_file"
    fi
    printf "%-35s | %s\n" "Owner / User" "$owner" >> "$report_file"
    printf "%-35s | %s\n" "Last Audit Date" "$report_date" >> "$report_file"

    echo "" >> "$report_file"
    echo "=====================================" >> "$report_file"
    echo "Notes:" >> "$report_file"
    echo "  - Serial Number 'could-not-read': no source returned a value - a" >> "$report_file"
    echo "    machine or packaging problem worth chasing" >> "$report_file"
    echo "  - Serial Number 'none-present': the hardware reports no serial, as a" >> "$report_file"
    echo "    virtual machine legitimately does - this asset needs a different" >> "$report_file"
    echo "    key in the register rather than a repair" >> "$report_file"
    echo "  - 'No suspicious software detected' requires manual review of:" >> "$report_file"
    echo "    * installed-packages.txt" >> "$report_file"
    echo "    * lynis-report.json security warnings" >> "$report_file"
    echo "  - Defender (AV) status: See 'Malware Scanner' field" >> "$report_file"
    echo "=====================================" >> "$report_file"

    cat "$report_file"
    return 0
}


